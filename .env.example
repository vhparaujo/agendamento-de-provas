# =============================================================================
# Portal de Agendamento de Provas — variaveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Documentacao OpenAPI em {API_PREFIX}/docs (JSON em {API_PREFIX}/docs-json).
# Vazio = ligada fora de producao, desligada quando NODE_ENV=production.
# Defina explicitamente para forcar: true publica a doc mesmo em producao.
SWAGGER_ENABLED=

# --- Banco de dados ----------------------------------------------------------
# Fora do Docker (app rodando na maquina, mysql no compose):
DATABASE_URL="mysql://agendamento:agendamento@localhost:3306/agendamento"
# Dentro do Docker compose o host vira o nome do servico:
# DATABASE_URL="mysql://agendamento:agendamento@mysql:3306/agendamento"

# Credenciais usadas pelo servico mysql do docker-compose
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=

# --- JWT ---------------------------------------------------------------------
# Gere com: openssl rand -hex 48
JWT_SECRET=troque-por-um-segredo-forte
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# JWT interno do aluno: curto, so para navegacao no portal
JWT_ALUNO_EXPIRES_IN=2h

# --- Seed do primeiro admin (idempotente) ------------------------------------
SEED_ADMIN_EMAIL=admin@ucb.br
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_ADMIN_NOME=Administrador

# --- Seguranca ---------------------------------------------------------------
# Limites de requisicao ficam DESLIGADOS sob NODE_ENV=test para nao derrubar os
# e2e que fazem varios logins de proposito. Nao mexa fora de teste: em qualquer
# outro NODE_ENV o limitador esta sempre ativo.
# THROTTLE_NOS_TESTES=true

# --- Regras de negocio -------------------------------------------------------
# Periodo letivo vigente no Brightspace (ex: 103)
PERIODO_LETIVO_ID=103
# A elegibilidade por STATUS CURSO nao e configuravel por .env: e uma lista
# explicita de status em src/enums/status-curso.enum.ts (unico ponto a alterar).
# Permitem agendar: Ativo, Transf. Interna, Transf. de Curriculo, Alter. de Habilitacao
# Bloqueiam:        Desistente, Trancado, Cancelado, Formado

# Filtro de turmas reais (CSV de turmas). Default SEGURO = true:
# enquanto nao houver turmas importadas, nada e agendavel.
# Inverta para false apenas se quiser liberar o agendamento sem o filtro.
TURMAS_FILTER_ENABLED=true

# --- LTI 1.3 (entrada do aluno) ----------------------------------------------
# COPIE da tela "Brightspace Registration Details", que aparece depois de salvar
# o registro em Manage Extensibility > LTI Advantage. Estes valores NAO sao
# adivinhaveis: variam por tenant e por regiao.
LTI_ISSUER=https://catolicatest.brightspace.com
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_AUTH_LOGIN_URL=
LTI_AUTH_TOKEN_URL=
LTI_JWKS_URL=
# Deve ser exatamente a URL de launch registrada no Brightspace
LTI_REDIRECT_URI=http://localhost:3000/api/lti/launch

# Chave privada RSA da ferramenta, em base64. Gere com: npm run lti:keygen
LTI_TOOL_PRIVATE_KEY=
LTI_TOOL_KEY_ID=agendamento-provas-1

# De onde tirar matricula e UserId do D2L dentro do id_token do launch.
# CONFIRMADO num launch real: os dois vem no claim PROPRIETARIO do Brightspace
# ("http://www.brightspace.com" -> org_defined_id e user_id), nao em parametros
# customizados. Os padroes de src/auth/lti/lti.config.ts ja apontam para la.
# A lista (separada por virgula) e tentada em ordem, do primeiro preenchido.
# Separador de nivel e "::" porque as chaves de claim do LTI sao URLs com pontos.
# Deixe em branco para usar os padroes.
#
# NUNCA coloque "sub" na lista de USER_ID: o sub do LTI e opaco
# (<guid>_76629) e a Valence API o REJEITA. O launch e recusado se o UserId
# nao for numerico, justamente para o erro aparecer aqui e nao no dia da prova.
LTI_CLAIM_MATRICULA=
LTI_CLAIM_USER_ID=

# true = loga os claims recebidos no launch, para descobrir os nomes reais.
# Ignorado quando NODE_ENV=production. Use no launch de teste e depois desligue.
LTI_DEBUG_CLAIMS=true

# Para onde mandar o aluno depois do launch (a URL do PORTAL, nao da API).
#
# PREENCHIDA: /lti/launch responde 303 redirecionando o navegador para ca, com
# um `code` de uso unico na query. O TOKEN NAO VAI NA URL — o portal o obtem
# chamando POST /lti/sessao com esse code. Ex: https://SEU-NGROK/aluno
#
# VAZIA: /lti/launch responde o JSON do launch, util para testar sem front.
PORTAL_ALUNO_URL=

# --- Valence API (D2L) -------------------------------------------------------
# Enquanto D2L_HABILITADO=false o cliente nao faz nenhuma chamada de rede: a fila
# de liberacao acumula em PENDENTE e nada e perdido. Ligue quando as credenciais
# existirem. Default seguro = false.
#
# LIGADO, ele tambem muda DE ONDE saem as disciplinas do aluno: em vez de so a
# turma de onde ele clicou (claim `context` do LTI), passam a vir todas as
# ofertas dele no periodo letivo cadastrado em PeriodoAgendamento, lidas por
# enrollments/users/{id}/orgUnits/. Exige a autorizacao OAuth ja feita
# (GET /api/d2l/callback) e D2L_BASE_URL preenchida.
D2L_HABILITADO=false

D2L_BASE_URL=https://catolicatest.brightspace.com
# Versao das APIs LE/LP. 1.82+ obrigatorio: rotas de quiz anteriores estao obsoletas.
D2L_API_VERSION=1.82

# Ha DOIS fluxos OAuth. Preencha UM.
#
# (a) PREFERIDO - Client Credentials + Usuario de Servico + JWT assertion.
#     Sem segredo compartilhado, sem refresh token para guardar.
D2L_TOKEN_URL=https://auth.brightspace.com/core/connect/token
D2L_CLIENT_ID=
D2L_CLIENT_ASSERTION_KEY=
D2L_ASSERTION_KEY_ID=

# (b) ALTERNATIVA - Authorization Code + refresh token.
#     ATENCAO: cada refresh gera um refresh token NOVO e invalida o anterior.
#     O sistema persiste o mais recente sozinho; nao edite este valor a mao
#     depois que a integracao estiver rodando.
D2L_CLIENT_SECRET=
D2L_REFRESH_TOKEN=

# URI de redirecionamento do app OAuth, EXATAMENTE como cadastrada em
# Manage Extensibility > OAuth 2.0 (o Brightspace compara byte a byte na troca
# do code — uma barra final a mais ja recusa). E o destino do redirect apos a
# tela de autorizacao, e a rota que o recebe e GET {API_PREFIX}/d2l/callback.
D2L_REDIRECT_URI=https://SEU-DOMINIO.ngrok-free.dev/api/d2l/callback

# Peca o minimo necessario.
D2L_SCOPES=enrollment:orgunit:read quizzing:quizzes:read quizzing:quizzes:write

# Type Ids de org unit DESTE tenant (validados no Postman).
# Course Offering = 3; o Periodo Letivo da UCB e um tipo customizado (103),
# nao o Semester padrao (5).
D2L_TIPO_OFERTA=3
D2L_TIPO_PERIODO_LETIVO=103

# Como achar o quiz da prova dentro da disciplina. A lista e tentada em ordem,
# sem acento e sem diferenciar maiusculas; vale o primeiro quiz cujo nome
# CONTENHA um destes termos. Se nenhum casar, a disciplina fica em FALHOU com o
# motivo — nunca se libera um quiz "por aproximacao".
D2L_QUIZ_TERMOS=prova final,prova presencial,prova

# Fuso das faixas. O special access exige datas em UTC; a conversao acontece
# num unico ponto (src/components/utc.util.ts).
D2L_TIMEZONE=America/Sao_Paulo
