# =============================================================================
# Portal de Agendamento de Provas — variaveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- Banco de dados ----------------------------------------------------------
# Fora do Docker (app rodando na maquina, mysql no compose):
DATABASE_URL="mysql://agendamento:agendamento@localhost:3306/agendamento"
# Dentro do Docker compose o host vira o nome do servico:
# DATABASE_URL="mysql://agendamento:agendamento@mysql:3306/agendamento"

# Credenciais usadas pelo servico mysql do docker-compose
MYSQL_DATABASE=agendamento
MYSQL_USER=agendamento
MYSQL_PASSWORD=agendamento
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# --- JWT ---------------------------------------------------------------------
# Gere com: openssl rand -hex 48
JWT_SECRET=troque-por-um-segredo-forte
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# JWT interno do aluno: curto, so para navegacao no portal
JWT_ALUNO_EXPIRES_IN=2h

# --- Seed do primeiro admin (idempotente) ------------------------------------
SEED_ADMIN_EMAIL=admin@ucb.br
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_ADMIN_NOME=Administrador

# --- Regras de negocio -------------------------------------------------------
# Filtro de turmas reais (CSV de turmas). Default SEGURO = true:
# enquanto nao houver turmas importadas, nada e agendavel.
# Inverta para false apenas se quiser liberar o agendamento sem o filtro.
TURMAS_FILTER_ENABLED=true

# --- LTI 1.3 (entrada do aluno) ----------------------------------------------
# Preencher quando a ferramenta for registrada no Brightspace
LTI_ISSUER=https://ava.catolica.edu.br
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_AUTH_LOGIN_URL=
LTI_JWKS_URL=
# Chave privada RSA da ferramenta em base64. Gere com: npm run lti:keygen
LTI_TOOL_PRIVATE_KEY=

# --- LTI (configuracao adicional) --------------------------------------------
LTI_REDIRECT_URI=http://localhost:3000/api/lti/launch
LTI_TOOL_KEY_ID=agendamento-provas-1
# Deixe em branco para usar os padroes (claim proprietario do Brightspace)
LTI_CLAIM_MATRICULA=
LTI_CLAIM_USER_ID=
# true = loga os claims recebidos no launch (ignorado em production)
LTI_DEBUG_CLAIMS=true
# URL do portal do aluno. Vazio = /lti/launch responde JSON (util para testar)
PORTAL_ALUNO_URL=http://SEU-DOMINIO/aluno

# --- Valence / D2L (OAuth 2.0 Authorization Code) ----------------------------
# Preencha CLIENT_ID e CLIENT_SECRET com o que a tela "Registrar um Aplicativo"
# devolver. O redirect precisa ser identico ao cadastrado la.
D2L_TOKEN_URL=https://auth.brightspace.com/core/connect/token
D2L_CLIENT_ID=
D2L_CLIENT_SECRET=
D2L_REDIRECT_URI=https://SEU-DOMINIO/api/d2l/callback

# Interruptor da integracao. Enquanto false, NENHUMA chamada de rede sai do
# cliente D2L. Vire para true SO DEPOIS de concluir a autorizacao OAuth
# (GET /api/d2l/callback grava o refresh token em integracao_d2l).
D2L_HABILITADO=true

# Precisa ser o MESMO tenant onde o app OAuth foi registrado.
D2L_BASE_URL=https://ava.catolica.edu.br

# Scopes para montar a URL de autorizacao no browser
D2L_SCOPES=core:*:* enrollment:orgunit:read organizations:organization:read orgunits:orgunit:read users:userdata:read

# Versoes da Valence API por produto.
# Confira em GET {D2L_BASE_URL}/d2l/api/versions/ antes de alterar.
D2L_API_VERSION_LP=1.62
D2L_API_VERSION_LE=1.82
D2L_TIPO_OFERTA=3
D2L_TIPO_PERIODO_LETIVO=103
