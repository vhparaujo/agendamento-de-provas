# =============================================================================
# Portal de Agendamento de Provas — variaveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Numero de proxies confiaveis na frente da API (`trust proxy` do Express).
# DESLIGADO por default: sem proxy real na frente, o cliente falsifica o proprio
# IP mandando X-Forwarded-For e escapa do limite de requisicoes.
#
# EM PRODUCAO ELE E OBRIGATORIO. A API fica atras do Nginx que serve o portal e
# repassa /api; sem o valor, `req.ip` vira o IP do container do Nginx e TODO
# aluno chega com o mesmo endereco. As duas coisas que dependem de IP quebram
# juntas: a auditoria aponta sempre o mesmo endereco, e o limite de 5/min do
# POST /api/lti/launch (@Throttle LIMITE_AUTENTICACAO) vira um orcamento
# COMPARTILHADO pela instituicao inteira — do sexto aluno do minuto em diante
# todos levam 429 ao clicar o link no Brightspace. Aconteceu em 26/08/2026, com
# o log cheio de LIMITE_REQUISICOES vindo de 172.19.0.1 (o gateway do Docker).
#
# `1` confia apenas no ultimo salto, que e o que o compose de producao monta.
# Com um balanceador institucional na frente do Nginx, use `2`. Aceita tambem as
# formas do Express ('loopback', lista de IPs/CIDRs).
#
# Como conferir depois de ligar: os WARN de LIMITE_REQUISICOES passam a trazer o
# IP real do aluno em vez do endereco do proxy.
TRUST_PROXY=1

# --- Banco de dados ----------------------------------------------------------
# Fora do Docker (app rodando na maquina, mysql no compose):
DATABASE_URL="mysql://agendamento:agendamento@localhost:3306/agendamento"
# Dentro do Docker compose o host vira o nome do servico:
# DATABASE_URL="mysql://agendamento:agendamento@mysql:3306/agendamento"

# Credenciais usadas pelo servico mysql do docker-compose
MYSQL_DATABASE=agendamento
MYSQL_USER=agendamento
MYSQL_PASSWORD=agendamento
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# --- JWT ---------------------------------------------------------------------
# Gere com: openssl rand -hex 48
JWT_SECRET=troque-por-um-segredo-forte
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# JWT interno do aluno: curto, so para navegacao no portal
JWT_ALUNO_EXPIRES_IN=2h

# --- Seed do primeiro admin (idempotente) ------------------------------------
SEED_ADMIN_EMAIL=admin@ucb.br
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_ADMIN_NOME=Administrador

# --- Regras de negocio -------------------------------------------------------
# Filtro de turmas reais (CSV de turmas). Default SEGURO = true:
# enquanto nao houver turmas importadas, nada e agendavel.
# Inverta para false apenas se quiser liberar o agendamento sem o filtro.
TURMAS_FILTER_ENABLED=true

# --- LTI 1.3 (entrada do aluno) ----------------------------------------------
# Preencher quando a ferramenta for registrada no Brightspace
LTI_ISSUER=https://ava.catolica.edu.br
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_AUTH_LOGIN_URL=
LTI_JWKS_URL=
# Chave privada RSA da ferramenta em base64. Gere com: npm run lti:keygen
LTI_TOOL_PRIVATE_KEY=

# --- LTI (configuracao adicional) --------------------------------------------
LTI_REDIRECT_URI=http://localhost:3000/api/lti/launch
LTI_TOOL_KEY_ID=agendamento-provas-1
# Deixe em branco para usar os padroes (claim proprietario do Brightspace)
LTI_CLAIM_MATRICULA=
LTI_CLAIM_USER_ID=
# true = loga os claims recebidos no launch (ignorado em production)
LTI_DEBUG_CLAIMS=true
# URL do portal do aluno. Vazio = /lti/launch responde JSON (util para testar)
PORTAL_ALUNO_URL=http://SEU-DOMINIO/aluno

# --- Valence / D2L (OAuth 2.0 Authorization Code) ----------------------------
# Preencha CLIENT_ID e CLIENT_SECRET com o que a tela "Registrar um Aplicativo"
# devolver. O redirect precisa ser identico ao cadastrado la.
D2L_TOKEN_URL=https://auth.brightspace.com/core/connect/token
D2L_CLIENT_ID=
D2L_CLIENT_SECRET=
D2L_REDIRECT_URI=https://SEU-DOMINIO/api/d2l/callback

# Interruptor da integracao. Enquanto false, NENHUMA chamada de rede sai do
# cliente D2L. Vire para true SO DEPOIS de concluir a autorizacao OAuth
# (GET /api/d2l/callback grava o refresh token em integracao_d2l).
#
# O DEFAULT DO CODIGO E `true` desde 18/08/2026 (era `false`): a troca de senha
# dos questionarios depende da Valence para descobrir o orgUnitId das turmas do
# CSV, e um ambiente que apenas esquecesse esta variavel rodaria o lote em zero
# turma — as provas ficariam sem senha no dia, sem erro nenhum.
D2L_HABILITADO=true

# Precisa ser o MESMO tenant onde o app OAuth foi registrado.
D2L_BASE_URL=https://ava.catolica.edu.br

# Scopes para montar a URL de autorizacao no browser (npm run d2l:autorizar).
# NAO acrescente `offline_access` — e convencao de outros provedores; a D2L
# valida o formato `group:resource:permission` e recusa a autorizacao inteira
# com `invalid_scope`. O refresh token ja vem por padrao no authorization_code.
#
# `quizzing:quizzes:read` e `:write` sao o que a TROCA DE SENHA precisa, e nao
# estao cobertos pelo `core:*:*`. ATENCAO: o escopo vive no CONSENTIMENTO, nao no
# .env — acrescentar aqui nao muda nada sozinho. Depois de editar, rode
# `npm run d2l:autorizar` e refaca a autorizacao no browser, senao todo PUT em
# quiz volta 403 e o erro parece problema de permissao de conteudo.
#
# `grades:gradevalues:read` e `grades:gradecategories:read` sao o que os
# CRITERIOS DE NOTA DA RODADA precisam (a prova substitutiva). Sao DOIS desde
# 08/09/2026, quando a regra passou a olhar tambem a N1: o primeiro le os valores
# (`GET .../grades/final/values/...` e `.../grades/{id}/values/...`), o segundo
# descobre em qual `gradeObjectId` mora a N1 de cada turma
# (`GET .../grades/categories/`) — porque a categoria tem um id DIFERENTE em cada
# turma, e o unico elo estavel e o NOME (ver D2L_CATEGORIA_N1).
#
# Sem qualquer um dos dois, a leitura volta 403 e NENHUM aluno consegue agendar a
# substitutiva — o filtro e fail-closed de proposito, porque liberar sem conferir
# a nota e o que ele existe para impedir. Vale o mesmo aviso do consentimento:
# reautorize depois de acrescentar. Confira com
# `npm run d2l:notas -- <orgUnitId> <userId>` antes de abrir a janela.
#
# `groups:group:read` e o que a TROCA DE GRUPO precisa (26/08/2026): sem ele, o
# `GET .../groupcategories/` volta 403 e o lote de datas aplica a data mas deixa
# TODA prova liberada para o grupo da sessao anterior — o aluno das 15h abre a
# prova das 19h. Isso NAO aparece como falha: o contador que denuncia e
# `gruposPendentes`, na tela e no relatorio. A rota de `conditionalRelease` nao
# tem escopo documentado e ja esta coberta pelo `core:*:*`. Vale o mesmo aviso do
# consentimento: reautorize depois de acrescentar.
#
# `groups:group:create`, `groups:enrollment:create` e `groups:enrollment:delete`
# sao o que a tela de GRUPOS DO BRIGHTSPACE precisa (14/09/2026): criar a
# categoria e os grupos, inscrever o aluno no grupo da sessao dele e tira-lo do
# antigo quando e remanejado. Sem eles, cada turma vira `FALHA_NA_API` com HTTP
# 403 no relatorio. Mesmo aviso: reautorize depois de acrescentar.
D2L_SCOPES=core:*:* enrollment:orgunit:read grades:gradecategories:read grades:gradeobjects:read grades:gradevalues:read groups:enrollment:create groups:enrollment:delete groups:group:create groups:group:read organizations:organization:read orgunits:orgunit:read quizzing:quizzes:read,write,delete users:userdata:read

# O NOME da categoria de notas que vale como N1 na prova substitutiva.
#
# A regra pede a N1 do aluno, e a Valence nao tem rota para "a N1": ela tem grade
# objects por id, e a N1 e uma CATEGORIA (`GradeObjectType: 9`) cujo id muda de
# turma para turma. O elo estavel entre a regra e o tenant e o nome que a
# secretaria deu a categoria — por isso ele e configuravel: renomear a categoria
# no Brightspace nao pode exigir deploy.
#
# A comparacao ignora caixa, acento e espacos nas pontas ("n1" e " N1 " casam),
# mas NAO adivinha: "Nota 1" nao casa com "N1", e a turma que nomear assim recusa
# TODOS os seus alunos (com um aviso por turma no log, listando os nomes que ela
# tem). Em branco = "N1".
D2L_CATEGORIA_N1=N1

# Versoes da Valence API por produto.
# Confira em GET {D2L_BASE_URL}/d2l/api/versions/ antes de alterar.
#
# ⚠️ `D2L_API_VERSION_LP` precisa ser >= 1.49: as rotas de `conditionalRelease` e
# de `groupcategories` — as que trocam o grupo que libera a prova — nao existem
# antes disso. Uma versao baixa nao devolve 400 explicando: devolve 404 com corpo
# VAZIO, indistinguivel de "questionario nao existe". O codigo recusa na primeira
# chamada dizendo isso, em vez de deixar investigar rede.
D2L_API_VERSION_LP=1.62
D2L_API_VERSION_LE=1.82
D2L_TIPO_OFERTA=3
D2L_TIPO_PERIODO_LETIVO=103

# --- Senha dos questionarios (troca em massa das provas no D2L) --------------
# O QUE O ADMIN ESCOLHE NAO ESTA AQUI, e nao deve voltar para ca:
#   - a grade dia x turno com as senhas mora em `senha_de_prova` (senha de prova
#     nao entra em arquivo de configuracao, e o cron precisa dela sem humano);
#   - o questionario-alvo e os HORARIOS de cada turno moram em
#     `configuracao_senha_quiz` e sao editados na tela (Senhas de prova).
# O que sobra aqui e infraestrutura: se ESTA INSTANCIA pode disparar, e com que
# ritmo o lote fala com a Valence.

# Opt-in DESTA INSTANCIA. Separado do D2L_HABILITADO de proposito (sao coisas
# diferentes, e deixar o servidor trocar senha sozinho e irreversivel) e separado
# dos horarios de proposito: aqui a pergunta e "esta replica dispara?", nao "a
# que horas a prova comeca". E a chave que se desliga numa replica extra.
SENHA_QUIZ_CRON_HABILITADO=false

# Os horarios de cada turno SAIRAM DAQUI em 19/08/2026 — eles sao cadastrados na
# tela, em Senhas de prova > Horarios do cron, e valem no minuto seguinte.
# O container roda com TZ=America/Sao_Paulo, entao o que a tela mostra e o
# horario de Brasilia.

# Janela de recuperacao: servidor que estava fora as 07:30 e sobe as 07:41 ainda
# aplica. Sem ela, um deploy na hora errada custa um turno inteiro de alunos.
SENHA_QUIZ_CRON_TOLERANCIA_MIN=30
# Teto de tentativas REAIS por celula dentro da janela. Sem ele, uma falha
# permanente (token sem escopo de quizzing) bate no D2L a cada minuto.
SENHA_QUIZ_CRON_MAX_TENTATIVAS=3

# Ritmo contra a Valence. O que importa e a RAZAO: 4 / 400ms ~= 10 req/s.
SENHA_QUIZ_CONCORRENCIA=4
SENHA_QUIZ_DELAY_MS=400
# Maior que o do enrollments (15s): objetos de quiz sao grandes.
SENHA_QUIZ_TIMEOUT_MS=30000
# Trava do laco de paginacao de GET quizzes/ — nao e otimizacao.
SENHA_QUIZ_MAX_PAGINAS=50

# O questionario-alvo NAO tem valor padrao, aqui nem no codigo: enquanto ninguem
# escolher pela tela, o lote RECUSA comecar. Um default plausivel ("Prova") seria
# pior que a ausencia — ele rodaria, casaria com o que estivesse por perto e
# ninguem descobriria ate o dia da prova.

# --- Integracao com outros sistemas (API key) ---------------------------------
# Quem consulta GET /api/integracao/... e OUTRO SISTEMA (hoje, o emissor da
# declaracao assinada), autenticado pelo header `X-API-Key`. Formato:
#   sistema:chave[,sistema:chave]
# O nome do sistema vai para a auditoria (INTEGRACAO_CONSULTA); a chave nunca.
# Cada chave com 32+ caracteres, sem espaco, virgula ou dois-pontos. Gere com:
#   openssl rand -hex 32
# Duas entradas com o MESMO sistema = rotacao (a nova entra, o outro lado troca,
# a antiga sai). VAZIA = as rotas de integracao recusam tudo (401), de proposito.
INTEGRACAO_API_KEYS=
# IPs exatos que podem chamar, separados por virgula. Vazio = qualquer origem
# (so a chave decide). So funciona com TRUST_PROXY correto — sem ele todo mundo
# chega com o IP do proxy, e liberar esse IP libera a internet inteira.
INTEGRACAO_IPS_PERMITIDOS=

# ---------------------------------------------------------------------------
# GRUPOS DO BRIGHTSPACE — lotes de criar grupos e inscrever alunos
# ---------------------------------------------------------------------------
# Espera antes de CADA chamada. Sequencial de proposito: sao milhares de POST
# pequenos, e paralelizar so trocaria espera por 429. 400 ms = ~150 chamadas/min.
GRUPOS_D2L_DELAY_MS=400
# Timeout de cada chamada.
GRUPOS_D2L_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# SPECIAL ACCESS POR AGENDAMENTO — o lote que grava o acesso de cada aluno
# ---------------------------------------------------------------------------
# Um PUT por aluno por questionario, sequencial. 400 ms = ~150 chamadas/min.
# Remover acesso (prova cancelada) exige `quizzing:quizzes:delete` no
# consentimento: acrescentar ao D2L_SCOPES nao basta, rode `npm run d2l:autorizar`.
SPECIAL_ACCESS_DELAY_MS=400
SPECIAL_ACCESS_TIMEOUT_MS=30000
