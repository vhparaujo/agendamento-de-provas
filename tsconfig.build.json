{
  "extends": "./tsconfig.json",
  // Compila SOMENTE src/, para que a saida seja dist/main.js (e nao dist/src/main.js).
  // prisma.config.ts e os seeds rodam via tsx, nao passam pelo build do Nest.
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "prisma",
    "prisma.config.ts",
    "**/*spec.ts"
  ]
}
