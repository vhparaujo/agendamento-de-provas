// ============================================================================
// schema.prisma — Portal de Agendamento de Provas (UCB)
// ============================================================================
// Fonte de verdade da modelagem. DTOs, services e controllers derivam daqui.
//
// FLUXO DO ALUNO:
// - Entra via LTI 1.3 (sem senha). A matricula chega no launch.
// - Matricula cruza com AlunoImportado (CSV) -> modalidade + polo.
// - Ve as FAIXAS (horarios) do polo dele que tenham vaga para a modalidade dele.
// - As disciplinas agendaveis = disciplinas do aluno na Valence ∩ TurmaImportada
//   (3o CSV de turmas reais com prova). NAO sao todas as disciplinas do aluno.
// - Escolhe UMA faixa. O sistema aloca numa sala daquela faixa+modalidade,
//   preenchendo em ordem (enche uma sala antes da proxima).
// - A reserva vale para TODAS as disciplinas agendaveis dele.
//
// MODELO DE SALAS/FAIXAS/MODALIDADE (nucleo):
// - Sala e FISICA e NEUTRA: polo + nome + capacidade. Sem modalidade fixa.
// - Faixa e um HORARIO NEUTRO: polo + data + horaInicio + horaFim. Sem modalidade.
// - SalaFaixa liga Sala + Faixa + Modalidade + vagas. A MODALIDADE VIVE AQUI.
//   Uma sala fisica pode ser Presencial numa faixa e EaD em outra; dentro de
//   uma faixa ela fica travada numa modalidade. Admin monta isso ao criar a faixa.
//
// CADASTRO:
// - Polos    -> SEED (prisma/seed-polos.ts), extraidos do CSV de alunos.
//               Nome unico = chave de casamento. Populam o dropdown de salas.
// - Salas    -> CADASTRO MANUAL pelo admin (nome + capacidade + polo via dropdown).
//               Import por CSV existe so como opcao alternativa secundaria.
// - Alunos   -> CSV. RA=matricula, ALUNO=nome, CURSO=curso (exibicao),
//               STATUS CURSO=ativo (so "Ativo" agenda), CAMPUS=polo.
//               Modalidade vem do dropdown no upload (aba EaD/Semi/Hibrido).
// - Turmas   -> CSV. Turmas/disciplinas reais que TERAO prova. Filtro final.
//
// PERIODO DE AGENDAMENTO:
// - Admin abre/fecha e define dataFechamento (fecha so por data/hora).
// - Linha do tempo do agendamento != datas das provas (faixas).
// ============================================================================

// NOTA (Prisma 7): o generator `prisma-client-js` foi substituido pelo generator
// `prisma-client` (rust-free), que exige `output` explicito. O client gerado vai
// para src/generated/prisma e NAO e versionado (ver .gitignore).
// A conexao MySQL usa o driver adapter @prisma/adapter-mariadb (obrigatorio no v7),
// configurado em src/database/prisma.service.ts a partir de DATABASE_URL.
// importFileExtension = "js" e OBRIGATORIO aqui: sem isso o Prisma infere a
// extensao a partir do tsconfig presente no momento do generate, e gera imports
// ".ts" quando roda em um contexto sem tsconfig (o build do Docker) — o que quebra
// o require() no dist compilado. Fixar torna o generate deterministico.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

// A URL de conexao NAO fica mais aqui (Prisma 7): o CLI a le de prisma.config.ts
// e o runtime a recebe via driver adapter. Fonte unica: DATABASE_URL no .env.
datasource db {
  provider = "mysql"
}

// ----------------------------------------------------------------------------
// AUTENTICACAO ADMIN
// ----------------------------------------------------------------------------

model Admin {
  id                 String    @id @default(uuid())
  email              String    @unique
  senhaHash          String
  nome               String?
  ativo              Boolean   @default(true)
  mustChangePassword Boolean   @default(false) // seed e reset setam true
  resetToken         String?
  resetTokenExpiry   DateTime?
  ultimoLogin        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("admin")
}

// ----------------------------------------------------------------------------
// MODALIDADE (duracao da prova)
// ----------------------------------------------------------------------------
// Uma modalidade por aluno. Ex: EaD=180min, Semi/Modular=90min, Presencial=120min.

model Modalidade {
  id             Int    @id @default(autoincrement())
  codigo         String @unique // EAD | SEMI | MODULAR | PRESENCIAL
  nome           String
  duracaoMinutos Int

  alunos       AlunoImportado[]
  salaFaixas   SalaFaixa[]
  agendamentos Agendamento[] // fotografia da modalidade do aluno na reserva

  @@map("modalidade")
}

// ----------------------------------------------------------------------------
// POLO / SALA (estrutura fisica) — sala e NEUTRA (sem modalidade)
// ----------------------------------------------------------------------------

// Polos sao populados por SEED (prisma/seed-polos.ts) a partir dos nomes
// distintos da coluna CAMPUS do CSV de alunos. O nome e UNICO e serve de chave
// de casamento: tanto o seed quanto o import de alunos usam a mesma string.
// No cadastro de Sala, o admin escolhe o Polo por dropdown (populado daqui).
model Polo {
  id     Int     @id @default(autoincrement())
  nome   String  @unique // igual ao valor bruto do CSV de alunos
  cidade String?
  ativo  Boolean @default(true)

  salas        Sala[]
  faixas       Faixa[]
  alunos       AlunoImportado[]
  agendamentos Agendamento[] // fotografia do polo do aluno na reserva

  @@map("polo")
}

model Sala {
  id         Int     @id @default(autoincrement())
  poloId     Int
  nome       String // "LAB 203", "M114"
  capacidade Int // vagas fisicas; default das vagas em SalaFaixa
  ativo      Boolean @default(true)

  polo       Polo        @relation(fields: [poloId], references: [id])
  salaFaixas SalaFaixa[]

  // Duas salas com o mesmo nome no mesmo polo seriam indistinguiveis para o
  // admin na hora de montar a faixa — e o aluno receberia "va para a M114" sem
  // saber qual. O nome se repetir entre polos diferentes e normal e permitido.
  @@unique([poloId, nome])
  @@index([poloId])
  @@map("sala")
}

// ----------------------------------------------------------------------------
// FAIXA (horario neutro que o admin abre) — ligada ao POLO, SEM modalidade
// ----------------------------------------------------------------------------

model Faixa {
  id         Int      @id @default(autoincrement())
  poloId     Int
  data       DateTime @db.Date
  horaInicio String // "08:30"
  horaFim    String // "11:30"
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  polo       Polo        @relation(fields: [poloId], references: [id])
  salaFaixas SalaFaixa[]

  @@index([poloId])
  @@index([data])
  @@map("faixa")
}

// ----------------------------------------------------------------------------
// SALA_FAIXA (NUCLEO) — Sala + Faixa + Modalidade + vagas
// ----------------------------------------------------------------------------
// A modalidade e a vaga vivem AQUI. Uma sala fisica travada numa modalidade
// dentro de uma faixa; livre para outra modalidade em outra faixa.
// ordem = sequencia de preenchimento (enche a de menor ordem primeiro).
// vagas = capacidade daquela sala nessa oferta (default = Sala.capacidade).

model SalaFaixa {
  id           Int @id @default(autoincrement())
  salaId       Int
  faixaId      Int
  modalidadeId Int
  vagas        Int // capacidade desta sala nesta faixa
  ordem        Int // ordem de preenchimento dentro da faixa+modalidade

  sala         Sala          @relation(fields: [salaId], references: [id])
  faixa        Faixa         @relation(fields: [faixaId], references: [id])
  modalidade   Modalidade    @relation(fields: [modalidadeId], references: [id])
  agendamentos Agendamento[]

  @@unique([salaId, faixaId]) // uma sala so entra uma vez por faixa (1 modalidade)
  @@unique([faixaId, modalidadeId, ordem]) // ordem unica por faixa+modalidade
  @@index([faixaId, modalidadeId]) // query: salas de uma modalidade numa faixa
  @@map("sala_faixa")
}

// ----------------------------------------------------------------------------
// ALUNO IMPORTADO (CSV) — fonte de verdade de modalidade + polo
// ----------------------------------------------------------------------------
// NAO e conta com senha. Reconhecido via LTI e cruzado por matricula.

// Campos vindos do CSV de alunos:
//   RA           -> matricula (chave de cruzamento com o launch LTI)
//   ALUNO        -> nome
//   CURSO        -> curso (SO EXIBICAO; nao entra em nenhuma regra/filtro)
//   STATUS CURSO -> ativo (true so quando "Ativo"; inativos nao agendam)
//   CAMPUS       -> polo (casa com Polo.nome por string exata)
//   modalidade   -> escolhida pelo admin no dropdown do upload (aba EaD/Semi/Hibrido)
// UM REGISTRO POR VINCULO (aluno + curso), nao por aluno.
// Decisao de 30/07/2026: um mesmo RA pode estar em dois cursos ao mesmo tempo
// (ex: Pedagogia/EaD e Psicologia/Hibrido) e precisa fazer as provas dos dois.
// Como a modalidade — e portanto a duracao da prova — vem do curso, cada vinculo
// e uma linha propria, com sua modalidade e seu polo.
// Por isso `curso` deixou de ser "so exibicao" e virou parte da chave; e por isso
// `matricula` sozinha NAO e mais unica.
// No launch LTI, um RA com mais de um vinculo faz o portal perguntar de qual
// curso e a prova; cada vinculo gera seu proprio agendamento.
model AlunoImportado {
  id           Int     @id @default(autoincrement())
  matricula    String // RA (alfanumerico: "0009552430", "A06103080", "UC25426847")
  nome         String?
  email        String? // EMAIL INSTITUCIONAL (alguns vazios)
  curso        String // CURSO — exibicao E parte da chave do vinculo
  // Valor BRUTO da coluna STATUS CURSO, guardado como veio no CSV. Existe para
  // que a regra de elegibilidade possa mudar sem reimportar as planilhas.
  statusCurso  String
  // Derivado de statusCurso pela lista em src/enums/status-curso.enum.ts.
  // "ativo" aqui significa PODE AGENDAR. Regra vigente (11/08/2026): SO "Ativo"
  // agenda — qualquer outro status (Desistente, Trancado, Cancelado, Formado,
  // Transf. Interna, Transf. de Curriculo, Alter. de Habilitacao, ou grafia
  // desconhecida) grava ativo=false. Continua sendo campo DERIVADO e nao copia
  // da string: a regra ja mudou uma vez e o enum e o unico ponto de alteracao.
  ativo        Boolean @default(true)
  modalidadeId Int
  poloId       Int
  importacaoId Int?

  modalidade   Modalidade     @relation(fields: [modalidadeId], references: [id])
  polo         Polo           @relation(fields: [poloId], references: [id])
  importacao   ImportacaoCsv? @relation(fields: [importacaoId], references: [id])
  agendamentos Agendamento[]

  excecoesCompulsorio ExcecaoCompulsorio[]

  // chave de idempotencia da importacao e do cruzamento com o launch LTI
  @@unique([matricula, curso])
  @@index([matricula]) // busca do launch: devolve 1..n vinculos
  @@index([modalidadeId])
  @@index([poloId])
  @@index([ativo])
  @@map("aluno_importado")
}

// ----------------------------------------------------------------------------
// TURMA IMPORTADA (3o CSV) — turmas reais que TERAO prova
// ----------------------------------------------------------------------------
// Filtro final: disciplina do aluno so e agendavel se o orgUnitId estiver aqui.

// Colunas reais do CSV (Tabela_Disciplinas_Turmas), separado por ";" (Excel pt-BR):
//   Curso                   -> curso            separa as disciplinas por vinculo
//   Codigo da Turma         -> codigoTurma      CHAVE de busca
//   Disciplina / Codigo EAD -> nomeDisciplina + codigoEad
//     A celula vem como "SAUDE COLETIVA (1-GSPS01EAD048)": nome e codigo da
//     DISCIPLINA juntos, separados na importacao. O prefixo numerico ("1-") e do
//     sistema de origem e NAO aparece no Brightspace, entao sai na leitura.
//
// POR QUE codigoTurma + codigoEad, e nao orgUnitId:
// o CSV nao traz o orgUnitId, e descobri-lo exige consultar a API. Mas o `Code`
// do Brightspace nesta instancia e COMPOSTO e carrega os dois codigos:
//
//   GSPS02_GSPS02EAD003_GSPS0I10227_2026/1
//          \_ disciplina  \_ turma
//
// e o launch/enrollments entrega esse Code. Com o par a oferta e identificada
// SEM depender do nome — que e o que resolve o caso real de tres disciplinas
// diferentes (HISTORIA, DANCA, LUTAS) rodando sob o MESMO codigo de turma.
// Regra completa em src/turma/service/turma-match.ts, portada do projeto
// ../brightspace-orgunits (src/matching.js), que ja resolve isto contra a
// instancia real da UCB.
//
// orgUnitId fica OPCIONAL: e APRENDIDO nos launches (todo aluno entrega o
// context.id da turma dele) e nunca sobrescrito.
//
// NAO HA `curso` AQUI (decisao de 10/08/2026). Uma turma tem alunos de VARIOS
// cursos — disciplina compartilhada, eletiva, equivalencia —, entao dizer que
// ela "e do curso X" e falso. Pior: o filtro por curso chegava a DESCARTAR
// disciplina valida de quem cursava uma oferta de outro curso.
//
// O preco, aceito conscientemente: quem tem dois vinculos NA MESMA MATRICULA
// recebe as disciplinas dos dois cursos juntas pelos enrollments, e as duracoes
// de prova sao diferentes. Sao 2 alunos em 7519 na base real (0,03%), e a
// informacao que resolveria isso e do par (aluno, turma) — nao da turma.

model TurmaImportada {
  id             Int     @id @default(autoincrement())
  codigoTurma    String // "GSPS0I10227"
  nomeDisciplina String // desempata quando o codigo de turma se repete
  codigoEad      String? // "GSPS02EAD003" — o outro token do Code composto
  orgUnitId      String? @unique // id no D2L, aprendido nos launches
  importacaoId   Int?

  importacao ImportacaoCsv? @relation(fields: [importacaoId], references: [id])

  // Idempotencia do upload: reimportar o mesmo arquivo atualiza, nunca duplica.
  // A chave e o PAR porque e o par que identifica a turma.
  @@unique([codigoTurma, nomeDisciplina])
  @@index([codigoTurma])
  @@map("turma_importada")
}

// ----------------------------------------------------------------------------
// IMPORTACAO CSV (auditoria dos 3 uploads)
// ----------------------------------------------------------------------------

model ImportacaoCsv {
  id           Int            @id @default(autoincrement())
  tipo         TipoImportacao
  nomeArquivo  String
  totalLinhas  Int
  importadoPor String?
  createdAt    DateTime       @default(now())

  alunos AlunoImportado[]
  turmas TurmaImportada[]

  @@map("importacao_csv")
}

enum TipoImportacao {
  ALUNOS
  SALAS
  TURMAS
}

// ----------------------------------------------------------------------------
// AGENDAMENTO (a reserva do aluno)
// ----------------------------------------------------------------------------
// Aponta para a SalaFaixa alocada (que ja carrega sala+faixa+modalidade).
// Ocupacao = count(Agendamento WHERE salaFaixaId = X) vs SalaFaixa.vagas.
// Alocacao sequencial + concorrencia tratadas em transacao no service.

// MODALIDADE E POLO SAO FOTOGRAFIA, nao consulta ao vinculo (13/08/2026).
//
// `AlunoImportado` e tabela de ESTADO ATUAL: cada importacao sobrescreve
// modalidade e polo do vinculo, e nao ha versao anterior. Sem estas duas
// colunas, exportar o semestre PASSADO mostrava a modalidade/polo de HOJE — o
// aluno que era EaD em 2026/1 e virou Modular em 2026/2 aparecia como Modular na
// lista de uma prova que fez como EaD, ao lado de data e sala corretas. Duas
// colunas da mesma linha discordando entre si.
//
// Sao FKs e nao texto (ao contrario de HistoricoAgendamento.de/para, que e frase
// pronta): aqui os valores tambem sao filtro de relatorio, e `Polo.nome` ja e
// imutavel por decisao — nao ha renome para congelar, so reatribuicao do aluno.
//
// Redundantes com `salaFaixa` POR CONSTRUCAO: a alocacao so aceita oferta da
// modalidade do aluno, e o portal recusa faixa de outro polo. E essa redundancia
// que torna o backfill exato — ver a migration.
model Agendamento {
  id              Int               @id @default(autoincrement())
  alunoId         Int
  salaFaixaId     Int // sala+faixa+modalidade alocada; admin pode trocar
  matricula       String // desnormalizado p/ exportacao
  userIdD2L       String // id numerico Valence vindo do launch LTI
  periodoLetivoId String
  modalidadeId    Int // do ALUNO, no momento da reserva
  poloId          Int // do ALUNO, no momento da reserva
  status          StatusAgendamento @default(CONFIRMADO)
  alocadoManual   Boolean           @default(false) // admin remanejou
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  aluno       AlunoImportado          @relation(fields: [alunoId], references: [id])
  salaFaixa   SalaFaixa               @relation(fields: [salaFaixaId], references: [id])
  modalidade  Modalidade              @relation(fields: [modalidadeId], references: [id])
  polo        Polo                    @relation(fields: [poloId], references: [id])
  disciplinas AgendamentoDisciplina[]
  syncs       SyncD2L[]
  historico   HistoricoAgendamento[]

  @@index([alunoId])
  @@index([salaFaixaId]) // usado na contagem de ocupacao
  @@index([matricula])
  @@index([modalidadeId])
  @@index([poloId])
  @@map("agendamento")
}

enum StatusAgendamento {
  CONFIRMADO
  CANCELADO
}

// ----------------------------------------------------------------------------
// HISTORICO DO AGENDAMENTO — quem mexeu, quando, e do que para o que
// ----------------------------------------------------------------------------
// Existe para responder UMA pergunta concreta: quando o aluno reclamar que
// "mudaram minha prova de horario", provar se foi ele mesmo ou a secretaria.
//
// Por que uma TABELA e nao o log de seguranca (AuditoriaService): o log vai para
// a saida do processo, e quem precisa da resposta e a secretaria, na tela, com o
// aluno na frente. Log que so o time de infra consegue ler nao resolve
// atendimento.
//
// `autor` e uma FOTOGRAFIA (matricula do aluno ou e-mail do admin), nao uma FK:
// o registro precisa continuar legivel mesmo que a conta do admin seja desativada
// ou o vinculo do aluno mude no proximo CSV.
//
// `de`/`para` sao texto pronto ("M114 · 20/08/2026 08:30-11:30") pelo mesmo
// motivo: ids soltos exigiriam reconstruir o passado para virar frase.

model HistoricoAgendamento {
  id            Int               @id @default(autoincrement())
  agendamentoId Int
  evento        EventoAgendamento
  autorTipo     AutorDaAlteracao
  autor         String // matricula (aluno) ou e-mail (admin)
  de            String? // situacao anterior, legivel
  para          String? // situacao nova, legivel
  createdAt     DateTime          @default(now())

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([agendamentoId])
  @@index([createdAt])
  @@map("historico_agendamento")
}

enum EventoAgendamento {
  CRIADO
  TROCADO // o ALUNO mudou de horario
  REMANEJADO // o ADMIN moveu de sala/horario
  CANCELADO
}

enum AutorDaAlteracao {
  ALUNO
  ADMIN
}

// ----------------------------------------------------------------------------
// AGENDAMENTO_DISCIPLINA (as N disciplinas cobertas pela reserva)
// ----------------------------------------------------------------------------

model AgendamentoDisciplina {
  id             Int     @id @default(autoincrement())
  agendamentoId  Int
  orgUnitId      String // disciplina (course offering) no D2L
  nomeDisciplina String?

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@unique([agendamentoId, orgUnitId])
  @@index([agendamentoId])
  @@map("agendamento_disciplina")
}

// ----------------------------------------------------------------------------
// SYNC_D2L (fila de gravacao de special access no Brightspace)
// ----------------------------------------------------------------------------
// PUT specialaccess por disciplina. 404 (nao matriculado) = NAO_MATRICULADO,
// estado esperado, nao erro.

model SyncD2L {
  id            Int        @id @default(autoincrement())
  agendamentoId Int
  orgUnitId     String
  status        StatusSync @default(PENDENTE)
  tentativas    Int        @default(0)
  ultimoErro    String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([agendamentoId])
  @@index([status])
  @@map("sync_d2l")
}

enum StatusSync {
  PENDENTE
  CONCLUIDO
  FALHOU
  NAO_MATRICULADO
}

// ----------------------------------------------------------------------------
// INTEGRACAO D2L — estado que precisa sobreviver a restart
// ----------------------------------------------------------------------------
// Existe por causa de UMA armadilha do OAuth do Brightspace: no fluxo de
// authorization code, cada refresh emite um refresh token NOVO e invalida o
// anterior. Guardar o token so no .env funciona exatamente uma vez — no primeiro
// refresh o valor do arquivo vira lixo, e a integracao morre silenciosamente ate
// alguem repetir a autorizacao manual.
//
// Uma linha so (id fixo em 1). O fluxo preferido (client credentials + usuario de
// servico) nao usa refresh token e deixa esta tabela vazia.

model IntegracaoD2L {
  id           Int      @id @default(1)
  refreshToken String   @db.Text
  atualizadoEm DateTime @updatedAt

  @@map("integracao_d2l")
}

// ----------------------------------------------------------------------------
// PERIODO DE AGENDAMENTO (aberto/fechado pelo admin)
// ----------------------------------------------------------------------------

model PeriodoAgendamento {
  id              Int       @id @default(autoincrement())
  periodoLetivoId String // Id do Periodo Letivo no Brightspace (ex: 103)
  descricao       String?
  aberto          Boolean   @default(false)
  dataAbertura    DateTime?
  dataFechamento  DateTime // fecha automatico quando bate esta data/hora
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("periodo_agendamento")
}

// ----------------------------------------------------------------------------
// AGENDAMENTO COMPULSORIO — o lote que agenda por quem nao agendou
// ----------------------------------------------------------------------------
// Fechado o periodo, quem nao marcou prova E alocado pela secretaria: enche a
// sala de menor `ordem` ate lotar (igual ao portal) e os dias da data mais
// proxima para a mais distante (`ordenarPorProximidade`).
//
// POR QUE ISTO E UMA TABELA, e nao uma resposta de requisicao:
//
// 1. O lote demora. Sao ~7 mil alunos e duas chamadas a Valence cada um (achar
//    o UserId, ler as disciplinas) — dezenas de minutos. Nenhum navegador nem
//    proxy segura essa conexao aberta, entao quem dispara recebe um id e volta
//    para perguntar como esta.
// 2. O resultado precisa sobreviver ao fim da execucao. "Faltaram 130 vagas em
//    Taguatinga/EAD" e a informacao que faz a secretaria abrir mais uma sala; se
//    ela vivesse so na tela, sumiria no primeiro F5.
// 3. E o registro de que o compulsorio ACONTECEU, com quem mandou e quando —
//    mesma necessidade que criou o HistoricoAgendamento.
//
// SIMULACAO e o modo padrao: roda tudo, conta tudo, GRAVA NADA. Existe porque a
// pergunta "cabe todo mundo?" so tem resposta honesta depois de percorrer a
// alocacao inteira — e descobrir que nao cabe no meio de uma execucao real
// deixaria metade dos alunos alocados e a outra metade nao.

model ExecucaoCompulsorio {
  id              Int            @id @default(autoincrement())
  status          StatusExecucao @default(EM_ANDAMENTO)
  // true = nada foi gravado. O relatorio sai igual nos dois modos.
  simulacao       Boolean        @default(true)
  // O recorte, congelado no inicio: o vigente pode mudar durante a execucao.
  periodoLetivoId String
  // Fotografia do e-mail do admin, como em HistoricoAgendamento.autor: precisa
  // continuar legivel se a conta for desativada depois.
  iniciadoPor     String

  totalElegiveis Int @default(0)
  processados    Int @default(0)
  alocados       Int @default(0)

  /// Preenchido so quando a execucao INTEIRA falha (banco fora, token vencido).
  /// Problema de UM aluno vira linha em ExcecaoCompulsorio, nunca isto.
  erro String? @db.Text

  iniciadoEm   DateTime  @default(now())
  concluidoEm  DateTime?
  // Batido a cada aluno: e assim que se distingue um lote VIVO de um que morreu
  // com o processo. Sem isto, um restart deixaria `EM_ANDAMENTO` para sempre e
  // bloquearia todo lote seguinte.
  atualizadoEm DateTime  @updatedAt

  excecoes ExcecaoCompulsorio[]

  @@index([status])
  @@map("execucao_compulsorio")
}

enum StatusExecucao {
  EM_ANDAMENTO
  CONCLUIDA
  FALHOU
}

// ----------------------------------------------------------------------------
// EXCECAO DO COMPULSORIO — quem NAO foi alocado, e por que
// ----------------------------------------------------------------------------
// A saida mais importante do lote. Alocar 4.600 pessoas nao gera trabalho para
// ninguem; os 200 que ficaram de fora sao a fila da secretaria, e cada motivo
// pede uma acao diferente: SEM_VAGA abre sala, SEM_CONTA_D2L vira chamado no
// suporte do LMS, SEM_DISCIPLINA_AGENDAVEL manda conferir o CSV de turmas.
//
// Uma linha por VINCULO, nao por RA: um aluno com dois cursos pode ser alocado
// em um e ficar de fora do outro.

model ExcecaoCompulsorio {
  id         Int           @id @default(autoincrement())
  execucaoId Int
  alunoId    Int
  matricula  String // desnormalizado: o relatorio precisa dela sem join
  motivo     MotivoExcecao
  /// O texto que a secretaria le ("Taguatinga / EAD: 130 sem vaga").
  detalhe    String?       @db.Text

  execucao ExecucaoCompulsorio @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  aluno    AlunoImportado      @relation(fields: [alunoId], references: [id])

  @@index([execucaoId])
  @@index([motivo])
  @@map("excecao_compulsorio")
}

enum MotivoExcecao {
  /// A matricula nao existe no Brightspace. Sem UserId nao ha disciplina.
  SEM_CONTA_D2L
  /// Duas contas com a mesma matricula: escolher uma nao e decisao nossa.
  MATRICULA_AMBIGUA
  /// UserId nao numerico — a Valence o recusaria ao ler as disciplinas.
  ID_INVALIDO_D2L
  /// Nenhuma disciplina do aluno cruzou com o CSV de turmas.
  SEM_DISCIPLINA_AGENDAVEL
  /// O polo do aluno nao tem faixa cadastrada para a modalidade dele.
  SEM_FAIXA_NO_POLO
  /// Ha faixa, mas todas as salas da modalidade lotaram. Abrir mais sala.
  SEM_VAGA
  /// Cancelou e nao remarcou. Fica de fora POR DECISAO do cliente, e aparece
  /// aqui para a secretaria ver quem ficou sem lugar nenhum.
  CANCELOU_E_NAO_REMARCOU
  /// A Valence falhou so para este aluno (rede, timeout). Reprocessavel.
  FALHA_NA_INTEGRACAO
  /// Alocado, mas a conta esta DESATIVADA no LMS: tem lugar na sala e nao
  /// conseguiria abrir a prova. Unico motivo que convive com uma alocacao.
  AVISO_CONTA_INATIVA_D2L
}
