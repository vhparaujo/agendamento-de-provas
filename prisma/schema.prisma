// ============================================================================
// schema.prisma — Portal de Agendamento de Provas (UCB)
// ============================================================================
// Fonte de verdade da modelagem. DTOs, services e controllers derivam daqui.
//
// FLUXO DO ALUNO:
// - Entra via LTI 1.3 (sem senha). A matricula chega no launch.
// - Matricula cruza com AlunoImportado (CSV) -> formato + polo.
// - Ve as FAIXAS (horarios) do polo dele que tenham vaga para o formato dele.
// - As disciplinas agendaveis = disciplinas do aluno na Valence ∩ TurmaImportada
//   (3o CSV de turmas reais com prova). NAO sao todas as disciplinas do aluno.
// - Escolhe UMA faixa. O sistema aloca numa sala daquela faixa+formato,
//   preenchendo em ordem (enche uma sala antes da proxima).
// - A reserva vale para TODAS as disciplinas agendaveis dele.
//
// MODELO DE SALAS/FAIXAS/MODALIDADE (nucleo):
// - Sala e FISICA e NEUTRA: polo + nome + capacidade. Sem formato fixo.
// - Faixa e um HORARIO NEUTRO: polo + data + horaInicio + horaFim. Sem formato.
// - SalaFaixa liga Sala + Faixa + Formato + vagas. O FORMATO VIVE AQUI.
//   Uma sala fisica pode ser Presencial numa faixa e EaD em outra; dentro de
//   uma faixa ela fica travada num formato. Admin monta isso ao criar a faixa.
//
// CADASTRO:
// - Polos    -> SEED (prisma/seed-polos.ts), extraidos do CSV de alunos.
//               Nome unico = chave de casamento. Populam o dropdown de salas.
// - Salas    -> CADASTRO MANUAL pelo admin (nome + capacidade + polo via dropdown).
//               Import por CSV existe so como opcao alternativa secundaria.
// - Alunos   -> CSV. RA=matricula, ALUNO=nome, CURSO=curso (exibicao),
//               STATUS CURSO=ativo ("Ativo"/"Cursando"/"Matriculado" agendam), CAMPUS=polo.
//               Formato vem do dropdown no upload (aba EaD/Semi/Modular).
// - Turmas   -> CSV. Turmas/disciplinas reais que TERAO prova. Filtro final.
//
// PERIODO DE AGENDAMENTO:
// - Admin abre/fecha e define dataFechamento (fecha so por data/hora).
// - Linha do tempo do agendamento != datas das provas (faixas).
// ============================================================================

// NOTA (Prisma 7): o generator `prisma-client-js` foi substituido pelo generator
// `prisma-client` (rust-free), que exige `output` explicito. O client gerado vai
// para src/generated/prisma e NAO e versionado (ver .gitignore).
// A conexao MySQL usa o driver adapter @prisma/adapter-mariadb (obrigatorio no v7),
// configurado em src/database/prisma.service.ts a partir de DATABASE_URL.
// importFileExtension = "js" e OBRIGATORIO aqui: sem isso o Prisma infere a
// extensao a partir do tsconfig presente no momento do generate, e gera imports
// ".ts" quando roda em um contexto sem tsconfig (o build do Docker) — o que quebra
// o require() no dist compilado. Fixar torna o generate deterministico.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

// A URL de conexao NAO fica mais aqui (Prisma 7): o CLI a le de prisma.config.ts
// e o runtime a recebe via driver adapter. Fonte unica: DATABASE_URL no .env.
datasource db {
  provider = "mysql"
}

// ----------------------------------------------------------------------------
// AUTENTICACAO ADMIN
// ----------------------------------------------------------------------------

model Admin {
  id                 String    @id @default(uuid())
  email              String    @unique
  senhaHash          String
  nome               String?
  ativo              Boolean   @default(true)
  mustChangePassword Boolean   @default(false) // seed e reset setam true
  resetToken         String?
  resetTokenExpiry   DateTime?
  ultimoLogin        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  /// O QUE este admin pode fazer. Ate 21/09/2026 nao havia nivel nenhum: ter um
  /// JWT de admin valido era acesso total. Ver enum NivelAdmin abaixo.
  ///
  /// O @default existe para a MIGRACAO, e nao para o cadastro: as contas que ja
  /// existiam tinham acesso total e precisam continuar tendo. Quem cria admin
  /// pela API sempre informa o nivel — CriarAdminDto o exige.
  nivel NivelAdmin @default(SUPERADMIN)

  @@map("admin")
}

/// ---------------------------------------------------------------------------
/// OS TRES NIVEIS ADMINISTRATIVOS (21/09/2026)
/// ---------------------------------------------------------------------------
/// A matriz completa (quais rotas cada um abre) NAO mora aqui: mora em
/// src/auth/jwt/niveis.ts, ao lado do guard que a aplica. Aqui fica so o que
/// cada nivel significa para quem le o banco.
enum NivelAdmin {
  /// Acesso total, inclusive a gestao de administradores. E o unico que cria
  /// outros admins e escolhe o nivel deles.
  SUPERADMIN

  /// A operacao do dia a dia: Inicio, Faixas, Polos e salas, Alunos,
  /// Relatorios, Agendamentos (SO LEITURA) e Senhas (SO LEITURA).
  ASSISTENTE_OPERACIONAL

  /// So a tela inicial, para acompanhar os numeros. Nao altera nada.
  VISUALIZADOR_EXECUTIVO
}

// ----------------------------------------------------------------------------
// FORMATO (duracao da prova)
// ----------------------------------------------------------------------------
// Um formato por aluno. Ex: EaD=180min, Semi/Modular=90min, Presencial=120min.

model Modalidade {
  id                  Int    @id @default(autoincrement())
  codigo              String @unique // EAD | SEMI | MODULAR | PRESENCIAL
  nome                String
  duracaoMinutos      Int
  /// O `TimeLimitValue` que o special access grava para quem e deste formato
  /// (15/09/2026). NAO e `duracaoMinutos`: aquela decide o tamanho da faixa que
  /// aceita o formato, e muda-la invalidaria faixas publicadas; esta e o
  /// tempo do questionario, e o admin a ajusta na tela. Nasce igual a duracao.
  /// O aluno do NIOP recebe esta mais `ConfiguracaoSpecialAccess.tempoExtraNiopMinutos`.
  tempoDeProvaMinutos Int

  alunos          AlunoImportado[]
  salaFaixas      SalaFaixa[]
  agendamentos    Agendamento[] // fotografia do formato do aluno na reserva
  janelas         JanelaDeProva[] // horarios do questionario no dia da prova
  // Qual periodo letivo do Brightspace vale para este formato em cada janela
  // de agendamento: modular anda por modulo, presencial por semestre.
  periodosLetivos PeriodoLetivoModalidade[]
  // As turmas em que o admin DECIDIU que esta e o formato da prova, por nao
  // haver como derivar (alunos de dois formatos na mesma turma).
  escolhasDeTurma ModalidadeEscolhidaDaTurma[]

  @@map("modalidade")
}

// ----------------------------------------------------------------------------
// POLO / SALA (estrutura fisica) — sala e NEUTRA (sem formato)
// ----------------------------------------------------------------------------

// Polos sao populados por SEED (prisma/seed-polos.ts) a partir dos nomes
// distintos da coluna CAMPUS do CSV de alunos. O nome e UNICO e serve de chave
// de casamento: tanto o seed quanto o import de alunos usam a mesma string.
// No cadastro de Sala, o admin escolhe o Polo por dropdown (populado daqui).
model Polo {
  id     Int     @id @default(autoincrement())
  nome   String  @unique // igual ao valor bruto do CSV de alunos
  cidade String?
  ativo  Boolean @default(true)
  /// O fuso IANA em que as FAIXAS deste polo sao lidas. "09:00" numa faixa de
  /// Cruzeiro do Sul (America/Rio_Branco) e 09:00 no relogio do Acre — 11:00 de
  /// Brasilia. E daqui que o special access tira o instante UTC da prova.
  ///
  /// Nome do fuso, nunca deslocamento ("-5"): o ICU sabe o offset de cada data, e
  /// um numero cravado so falharia se o horario de verao voltasse — em silencio,
  /// uma hora errada em toda prova do polo. A lista aceita esta em
  /// src/polo/service/fusos.ts.
  fuso   String  @default("America/Sao_Paulo") @db.VarChar(64)

  salas        Sala[]
  faixas       Faixa[]
  alunos       AlunoImportado[]
  agendamentos Agendamento[] // fotografia do polo do aluno na reserva

  @@map("polo")
}

model Sala {
  id         Int     @id @default(autoincrement())
  poloId     Int
  nome       String // "LAB 203", "M114"
  capacidade Int // vagas fisicas; default das vagas em SalaFaixa
  ativo      Boolean @default(true)

  polo       Polo        @relation(fields: [poloId], references: [id])
  salaFaixas SalaFaixa[]

  // Duas salas com o mesmo nome no mesmo polo seriam indistinguiveis para o
  // admin na hora de montar a faixa — e o aluno receberia "va para a M114" sem
  // saber qual. O nome se repetir entre polos diferentes e normal e permitido.
  @@unique([poloId, nome])
  @@index([poloId])
  @@map("sala")
}

// ----------------------------------------------------------------------------
// FAIXA (horario neutro que o admin abre) — ligada ao POLO, SEM formato
// ----------------------------------------------------------------------------

model Faixa {
  id         Int      @id @default(autoincrement())
  poloId     Int
  data       DateTime @db.Date
  horaInicio String // "08:30"
  horaFim    String // "11:30"
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  polo       Polo        @relation(fields: [poloId], references: [id])
  salaFaixas SalaFaixa[]

  @@index([poloId])
  @@index([data])
  @@map("faixa")
}

// ----------------------------------------------------------------------------
// SALA_FAIXA (NUCLEO) — Sala + Faixa + Formato + vagas
// ----------------------------------------------------------------------------
// O formato e a vaga vivem AQUI. Uma sala fisica travada num formato
// dentro de uma faixa; livre para outro formato em outra faixa.
// ordem = sequencia de preenchimento (enche a de menor ordem primeiro).
// vagas = capacidade daquela sala nessa oferta (default = Sala.capacidade).

model SalaFaixa {
  id           Int @id @default(autoincrement())
  salaId       Int
  faixaId      Int
  modalidadeId Int
  vagas        Int // capacidade desta sala nesta faixa
  ordem        Int // ordem de preenchimento dentro da faixa+formato

  sala         Sala          @relation(fields: [salaId], references: [id])
  faixa        Faixa         @relation(fields: [faixaId], references: [id])
  modalidade   Modalidade    @relation(fields: [modalidadeId], references: [id])
  agendamentos Agendamento[]

  @@unique([salaId, faixaId]) // uma sala so entra uma vez por faixa (1 formato)
  @@unique([faixaId, modalidadeId, ordem]) // ordem unica por faixa+formato
  @@index([faixaId, modalidadeId]) // query: salas de um formato numa faixa
  @@map("sala_faixa")
}

// ----------------------------------------------------------------------------
// ALUNO IMPORTADO (CSV) — fonte de verdade de formato + polo
// ----------------------------------------------------------------------------
// NAO e conta com senha. Reconhecido via LTI e cruzado por matricula.

// Campos vindos do CSV de alunos:
//   RA           -> matricula (chave de cruzamento com o launch LTI)
//   ALUNO        -> nome
//   CURSO        -> curso (SO EXIBICAO; nao entra em nenhuma regra/filtro)
//   STATUS CURSO -> ativo (true so quando "Ativo"; inativos nao agendam)
//   CAMPUS       -> polo (casa com Polo.nome por string exata)
//   formato      -> escolhido pelo admin no dropdown do upload (aba EaD/Semi/Modular)
// UM REGISTRO POR VINCULO (aluno + curso), nao por aluno.
// Decisao de 30/07/2026: um mesmo RA pode estar em dois cursos ao mesmo tempo
// (ex: Pedagogia/EaD e Psicologia/Modular) e precisa fazer as provas dos dois.
// Como o formato — e portanto a duracao da prova — vem do curso, cada vinculo
// e uma linha propria, com seu formato e seu polo.
// Por isso `curso` deixou de ser "so exibicao" e virou parte da chave; e por isso
// `matricula` sozinha NAO e mais unica.
// No launch LTI, um RA com mais de um vinculo faz o portal perguntar de qual
// curso e a prova; cada vinculo gera seu proprio agendamento.
model AlunoImportado {
  id           Int     @id @default(autoincrement())
  matricula    String // RA (alfanumerico: "0009552430", "A06103080", "UC25426847")
  nome         String?
  email        String? // EMAIL INSTITUCIONAL (alguns vazios)
  curso        String // CURSO — exibicao E parte da chave do vinculo
  // Valor BRUTO da coluna STATUS CURSO, guardado como veio no CSV. Existe para
  // que a regra de elegibilidade possa mudar sem reimportar as planilhas.
  statusCurso  String
  // Derivado de statusCurso pela lista em src/enums/status-curso.enum.ts.
  // "ativo" aqui significa PODE AGENDAR. Regra vigente (20/10/2026): SO "Ativo",
  // "Cursando" e "Matriculado" agendam — qualquer outro status (Desistente, Matricula Trancada, Cancelado, Formado,
  // Transf. Interna, Transf. de Curriculo, Alter. de Habilitacao, ou grafia
  // desconhecida) grava ativo=false. Continua sendo campo DERIVADO e nao copia
  // da string: a regra ja mudou uma vez e o enum e o unico ponto de alteracao.
  //
  // ⚠️ `ativo` tambem e false quando o vinculo esta FORA DA PLANILHA (abaixo):
  // pode agendar = status que permite E presente na ultima lista completa.
  ativo        Boolean @default(true)
  modalidadeId Int
  poloId       Int
  importacaoId Int?

  // FORA DA PLANILHA (20/10/2026): o vinculo nao veio no ultimo CSV COMPLETO do
  // formato dele — o aluno saiu da universidade. E uma MARCA, nao um DELETE:
  // apagar levaria junto as provas ja feitas (a FK de agendamento recusa, e com
  // razao). Enquanto marcado, `ativo` = false. Voltar em qualquer CSV, completo
  // ou parcial, limpa a marca. Ver `saidas-da-planilha.ts`.
  foraDaPlanilhaEm           DateTime?
  foraDaPlanilhaImportacaoId Int?

  modalidade               Modalidade     @relation(fields: [modalidadeId], references: [id])
  polo                     Polo           @relation(fields: [poloId], references: [id])
  importacao               ImportacaoCsv? @relation("VinculosGravados", fields: [importacaoId], references: [id])
  // A importacao completa que marcou a saida. SetNull: apagar o registro de
  // auditoria nao pode devolver o aluno a lista.
  foraDaPlanilhaImportacao ImportacaoCsv? @relation("VinculosForaDaPlanilha", fields: [foraDaPlanilhaImportacaoId], references: [id], onDelete: SetNull)
  agendamentos             Agendamento[]

  excecoesCompulsorio ExcecaoCompulsorio[]

  // chave de idempotencia da importacao e do cruzamento com o launch LTI
  @@unique([matricula, curso])
  @@index([matricula]) // busca do launch: devolve 1..n vinculos
  @@index([modalidadeId])
  @@index([poloId])
  @@index([ativo])
  @@index([modalidadeId, foraDaPlanilhaEm])
  @@map("aluno_importado")
}

// ----------------------------------------------------------------------------
// TURMA IMPORTADA (3o CSV) — turmas reais que TERAO prova
// ----------------------------------------------------------------------------
// Filtro final: disciplina do aluno so e agendavel se o orgUnitId estiver aqui.

// Colunas reais do CSV (Tabela_Disciplinas_Turmas), separado por ";" (Excel pt-BR):
//   Curso                   -> curso            separa as disciplinas por vinculo
//   Codigo da Turma         -> codigoTurma      CHAVE de busca
//   Disciplina / Codigo EAD -> nomeDisciplina + codigoEad
//     A celula vem como "SAUDE COLETIVA (1-GSPS01EAD048)": nome e codigo da
//     DISCIPLINA juntos, separados na importacao. O prefixo numerico ("1-") e do
//     sistema de origem e NAO aparece no Brightspace, entao sai na leitura.
//
// POR QUE codigoTurma + codigoEad, e nao orgUnitId:
// o CSV nao traz o orgUnitId, e descobri-lo exige consultar a API. Mas o `Code`
// do Brightspace nesta instancia e COMPOSTO e carrega os dois codigos:
//
//   GSPS02_GSPS02EAD003_GSPS0I10227_2026/1
//          \_ disciplina  \_ turma
//
// e o launch/enrollments entrega esse Code. Com o par a oferta e identificada
// SEM depender do nome — que e o que resolve o caso real de tres disciplinas
// diferentes (HISTORIA, DANCA, LUTAS) rodando sob o MESMO codigo de turma.
// Regra completa em src/turma/service/turma-match.ts, portada do projeto
// ../brightspace-orgunits (src/matching.js), que ja resolve isto contra a
// instancia real da UCB.
//
// orgUnitId fica OPCIONAL: e APRENDIDO nos launches (todo aluno entrega o
// context.id da turma dele) e nunca sobrescrito.
//
// NAO HA `curso` AQUI (decisao de 10/08/2026). Uma turma tem alunos de VARIOS
// cursos — disciplina compartilhada, eletiva, equivalencia —, entao dizer que
// ela "e do curso X" e falso. Pior: o filtro por curso chegava a DESCARTAR
// disciplina valida de quem cursava uma oferta de outro curso.
//
// O preco, aceito conscientemente: quem tem dois vinculos NA MESMA MATRICULA
// recebe as disciplinas dos dois cursos juntas pelos enrollments, e as duracoes
// de prova sao diferentes. Sao 2 alunos em 7519 na base real (0,03%), e a
// informacao que resolveria isso e do par (aluno, turma) — nao da turma.

model TurmaImportada {
  id             Int     @id @default(autoincrement())
  codigoTurma    String // "GSPS0I10227"
  nomeDisciplina String // desempata quando o codigo de turma se repete
  codigoEad      String? // "GSPS02EAD003" — o outro token do Code composto
  orgUnitId      String? @unique // id no D2L, aprendido nos launches
  importacaoId   Int?
  /// Como a PLANILHA chama esta turma, quando o admin a renomeou pela tela
  /// (`PATCH /turmas/:id`). Null = nunca renomeada: o nome e o do CSV.
  ///
  /// Existe para a reimportacao nao perder a turma. O upsert e pelo par
  /// [codigoTurma, nomeDisciplina]; com o nome trocado e a planilha ainda com o
  /// antigo, o par nao casaria e o upload criaria uma SEGUNDA linha — sem o
  /// orgUnitId aprendido e empatando com a renomeada no cruzamento (AMBIGUA),
  /// o que bloquearia o agendamento da disciplina.
  nomeNaPlanilha String?
  /// Id da turma-disciplina no sistema academico (coluna OPCIONAL do CSV).
  /// Serve so para a API de integracao identificar a turma do lado de la.
  /// Null = o CSV nao trouxe. A reimportacao sobrescreve, como o `codigoEad`.
  idTurmaDisc    String?

  importacao ImportacaoCsv? @relation(fields: [importacaoId], references: [id])

  // Idempotencia do upload: reimportar o mesmo arquivo atualiza, nunca duplica.
  // A chave e o PAR porque e o par que identifica a turma.
  @@unique([codigoTurma, nomeDisciplina])
  @@index([codigoTurma])
  @@map("turma_importada")
}

// ----------------------------------------------------------------------------
// IMPORTACAO CSV (auditoria dos 3 uploads)
// ----------------------------------------------------------------------------

model ImportacaoCsv {
  id             Int            @id @default(autoincrement())
  tipo           TipoImportacao
  nomeArquivo    String
  totalLinhas    Int
  importadoPor   String?
  createdAt      DateTime       @default(now())
  // So no CSV de alunos: o admin marcou "este arquivo e a lista completa do
  // formato", e por isso a importacao comparou com o banco.
  listaCompleta  Boolean        @default(false)
  // Quantos vinculos ESTA importacao marcou como fora da planilha (0 na
  // simulacao e nas parciais).
  saidasMarcadas Int            @default(0)

  alunos                 AlunoImportado[] @relation("VinculosGravados")
  vinculosForaDaPlanilha AlunoImportado[] @relation("VinculosForaDaPlanilha")
  turmas                 TurmaImportada[]

  @@map("importacao_csv")
}

enum TipoImportacao {
  ALUNOS
  SALAS
  TURMAS
}

// ----------------------------------------------------------------------------
// AGENDAMENTO (a reserva do aluno)
// ----------------------------------------------------------------------------
// Aponta para a SalaFaixa alocada (que ja carrega sala+faixa+formato).
// Ocupacao = count(Agendamento WHERE salaFaixaId = X) vs SalaFaixa.vagas.
// Alocacao sequencial + concorrencia tratadas em transacao no service.

// FORMATO E POLO SAO FOTOGRAFIA, nao consulta ao vinculo (13/08/2026).
//
// `AlunoImportado` e tabela de ESTADO ATUAL: cada importacao sobrescreve
// formato e polo do vinculo, e nao ha versao anterior. Sem estas duas
// colunas, exportar o semestre PASSADO mostrava o formato/polo de HOJE — o
// aluno que era EaD em 2026/1 e virou Modular em 2026/2 aparecia como Modular na
// lista de uma prova que fez como EaD, ao lado de data e sala corretas. Duas
// colunas da mesma linha discordando entre si.
//
// Sao FKs e nao texto (ao contrario de HistoricoAgendamento.de/para, que e frase
// pronta): aqui os valores tambem sao filtro de relatorio, e `Polo.nome` ja e
// imutavel por decisao — nao ha renome para congelar, so reatribuicao do aluno.
//
// Redundantes com `salaFaixa` POR CONSTRUCAO: a alocacao so aceita oferta do
// formato do aluno, e o portal recusa faixa de outro polo. E essa redundancia
// que torna o backfill exato — ver a migration.
model Agendamento {
  id              Int               @id @default(autoincrement())
  alunoId         Int
  salaFaixaId     Int // sala+faixa+formato alocado; admin pode trocar
  matricula       String // desnormalizado p/ exportacao
  userIdD2L       String // id numerico Valence vindo do launch LTI
  periodoLetivoId String
  /// A rodada do periodo vigente no momento da reserva — fotografia, como
  /// `modalidadeId` e `poloId`. Editar a janela depois nao remarca a prova, e e
  /// esta coluna que separa a N2 da SUB do MESMO semestre: sem ela, as duas
  /// provas do aluno seriam indistinguiveis em toda consulta por periodo letivo.
  rodada          String
  modalidadeId    Int // do ALUNO, no momento da reserva
  poloId          Int // do ALUNO, no momento da reserva
  status          StatusAgendamento @default(CONFIRMADO)
  alocadoManual   Boolean           @default(false) // admin remanejou
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  aluno       AlunoImportado          @relation(fields: [alunoId], references: [id])
  salaFaixa   SalaFaixa               @relation(fields: [salaFaixaId], references: [id])
  modalidade  Modalidade              @relation(fields: [modalidadeId], references: [id])
  polo        Polo                    @relation(fields: [poloId], references: [id])
  disciplinas AgendamentoDisciplina[]
  syncs       SyncD2L[]
  historico   HistoricoAgendamento[]

  @@index([alunoId])
  @@index([salaFaixaId]) // usado na contagem de ocupacao
  @@index([matricula])
  @@index([modalidadeId])
  @@index([poloId])
  @@index([periodoLetivoId, rodada]) // a lista geral da integracao recorta por periodo
  @@map("agendamento")
}

enum StatusAgendamento {
  CONFIRMADO
  CANCELADO
}

// ----------------------------------------------------------------------------
// HISTORICO DO AGENDAMENTO — quem mexeu, quando, e do que para o que
// ----------------------------------------------------------------------------
// Existe para responder UMA pergunta concreta: quando o aluno reclamar que
// "mudaram minha prova de horario", provar se foi ele mesmo ou a administracao.
//
// Por que uma TABELA e nao o log de seguranca (AuditoriaService): o log vai para
// a saida do processo, e quem precisa da resposta e a administracao, na tela, com o
// aluno na frente. Log que so o time de infra consegue ler nao resolve
// atendimento.
//
// `autor` e uma FOTOGRAFIA (matricula do aluno ou e-mail do admin), nao uma FK:
// o registro precisa continuar legivel mesmo que a conta do admin seja desativada
// ou o vinculo do aluno mude no proximo CSV.
//
// `de`/`para` sao texto pronto ("M114 · 20/08/2026 08:30-11:30") pelo mesmo
// motivo: ids soltos exigiriam reconstruir o passado para virar frase.

model HistoricoAgendamento {
  id            Int               @id @default(autoincrement())
  agendamentoId Int
  evento        EventoAgendamento
  autorTipo     AutorDaAlteracao
  autor         String // matricula (aluno) ou e-mail (admin)
  de            String? // situacao anterior, legivel
  para          String? // situacao nova, legivel
  /// O motivo que o admin escreveu ao remanejar. Opcional: vazio quando ele nao
  /// quis justificar, e sempre vazio nos eventos do aluno.
  justificativa String?           @db.VarChar(500)
  createdAt     DateTime          @default(now())

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([agendamentoId])
  @@index([createdAt])
  @@map("historico_agendamento")
}

enum EventoAgendamento {
  CRIADO
  TROCADO // o ALUNO mudou de horario
  REMANEJADO // o ADMIN moveu de sala/horario
  CANCELADO
}

enum AutorDaAlteracao {
  ALUNO
  ADMIN
}

// ----------------------------------------------------------------------------
// AGENDAMENTO_DISCIPLINA (as N disciplinas cobertas pela reserva)
// ----------------------------------------------------------------------------

model AgendamentoDisciplina {
  id             Int      @id @default(autoincrement())
  agendamentoId  Int
  orgUnitId      String // disciplina (course offering) no D2L
  nomeDisciplina String?
  /// AS DUAS NOTAS que decidiram a reserva NESTA disciplina — fotografia, como
  /// `rodada` e `poloId` no agendamento.
  ///
  /// So sao preenchidas quando a janela tinha filtro de nota (a substitutiva);
  /// na N2 ficam nulas, porque nota nenhuma foi consultada. Existem para
  /// responder a pergunta que a administração recebe com o aluno na frente — "por
  /// que ele agendou substitutiva desta materia?" —, e a nota no Brightspace
  /// pode ter mudado depois. Sem as colunas, a unica resposta seria consultar a
  /// Valence de novo e ver numeros que talvez ja nao sejam os que decidiram.
  ///
  /// Sao DUAS desde 08/09/2026 porque a regra passou a olhar duas notas: com so
  /// a final gravada, "ele tinha N1 suficiente?" ficaria sem resposta — e e
  /// justamente o criterio novo, o que a administracao ainda nao conhece de cor.
  /// `notaN1` fica nula tambem nas reservas gravadas ANTES desta data: elas
  /// foram decididas pela regra antiga, e inventar um valor seria mentir sobre
  /// o que aconteceu.
  notaFinal      Decimal? @db.Decimal(5, 2)
  notaN1         Decimal? @db.Decimal(5, 2)

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@unique([agendamentoId, orgUnitId])
  @@index([agendamentoId])
  @@map("agendamento_disciplina")
}

// ----------------------------------------------------------------------------
// SYNC_D2L (fila de gravacao de special access no Brightspace)
// ----------------------------------------------------------------------------
// PUT specialaccess por disciplina. 404 (nao matriculado) = NAO_MATRICULADO,
// estado esperado, nao erro.
//
// ⚠️ SEM USO. O special access e gravado pelo LOTE de `src/special-access`
// (ExecucaoSpecialAccess), que le o estado do Brightspace e grava so a diferenca.
// `quizIds`, `startDateAplicado`, `endDateAplicado` e `DISPENSADO` vieram da
// migration 20260915120000, de uma fila por agendamento que nao seguiu; ficam
// porque ja estao aplicados.

model SyncD2L {
  id            Int        @id @default(autoincrement())
  agendamentoId Int
  orgUnitId     String
  status        StatusSync @default(PENDENTE)
  tentativas    Int        @default(0)
  ultimoErro    String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  quizIds           String?   @db.VarChar(500)
  startDateAplicado DateTime?
  endDateAplicado   DateTime?

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([agendamentoId])
  @@index([status])
  @@map("sync_d2l")
}

enum StatusSync {
  PENDENTE
  CONCLUIDO
  FALHOU
  NAO_MATRICULADO
  DISPENSADO
}

// ----------------------------------------------------------------------------
// INTEGRACAO D2L — estado que precisa sobreviver a restart
// ----------------------------------------------------------------------------
// Existe por causa de UMA armadilha do OAuth do Brightspace: no fluxo de
// authorization code, cada refresh emite um refresh token NOVO e invalida o
// anterior. Guardar o token so no .env funciona exatamente uma vez — no primeiro
// refresh o valor do arquivo vira lixo, e a integracao morre silenciosamente ate
// alguem repetir a autorizacao manual.
//
// Uma linha so (id fixo em 1). O fluxo preferido (client credentials + usuario de
// servico) nao usa refresh token e deixa esta tabela vazia.

model IntegracaoD2L {
  id           Int      @id @default(1)
  refreshToken String   @db.Text
  atualizadoEm DateTime @updatedAt

  @@map("integracao_d2l")
}

// ----------------------------------------------------------------------------
// PERIODO DE AGENDAMENTO (aberto/fechado pelo admin)
// ----------------------------------------------------------------------------
//
// A identidade do periodo e o PAR `periodoLetivoId + rodada`, e nao o
// `periodoLetivoId` sozinho: o mesmo semestre tem mais de uma prova (a regular e
// a substitutiva), e cada uma abre a sua janela, com as suas faixas e o seu
// prazo. Antes da `rodada`, cadastrar a segunda janela do semestre era recusado
// como duplicata — e, se passasse, a trava "uma prova por vinculo no semestre"
// impediria o mesmo aluno de agendar as duas.
//
// E UMA JANELA COBRE MAIS DE UM PERIODO LETIVO AO MESMO TEMPO. A UCB divide o
// ano de duas formas simultaneas: EaD/Semi/Modular andam por MODULO (quatro por
// ano — 2026/1..2026/4) e Presencial anda por SEMESTRE (dois — 2026/1, 2026/2).
// Em novembro de 2026 o aluno EaD esta sob `2026/4` e o presencial sob `2026/2`,
// que sao dois org units DIFERENTES e VIVOS ao mesmo tempo no Brightspace. Como
// as disciplinas do aluno saem dos descendentes desse org unit, o id errado nao
// da erro nenhum: devolve lista vazia, e o formato inteiro recebe "nenhuma
// disciplina sua aparece no periodo letivo vigente".
//
// Por isso o `periodoLetivoId` de uma janela nao e uma string, e sim um MAPA por
// formato (`PeriodoLetivoModalidade`). O que continua unico na janela e o
// PRAZO: datas, `rodada` e faixa de nota valem para todo mundo.

model PeriodoAgendamento {
  id              Int       @id @default(autoincrement())
  /// O periodo letivo PRINCIPAL da janela — na pratica o dos modulos, que cobre
  /// tres dos quatro formatos. NAO e mais o unico: quem responde "qual org
  /// unit vale para ESTE aluno" e `letivosPorModalidade`.
  ///
  /// Continua existindo por tres razoes concretas:
  /// 1. e a metade do par que identifica a janela (`criar` recusa a duplicata
  ///    `periodoLetivoId + rodada`, e e assim que 2026/3+SUB convive com
  ///    2026/3+N2);
  /// 2. e o rotulo da janela na tela do admin e no portal do aluno;
  /// 3. e o FALLBACK de um formato sem linha no mapa — semear um quinto
  ///    formato nao pode derrubar o agendamento dos outros quatro.
  periodoLetivoId String // Id do Periodo Letivo no Brightspace (ex: 103)
  /// Qual prova do semestre e esta janela: "N2", "SUB", "N1"... Texto livre de
  /// proposito: quem nomeia a rodada e a administracao, e um enum obrigaria uma
  /// migration a cada nome novo. O default mantem os semestres ja cadastrados,
  /// que sao todos da prova regular.
  rodada          String    @default("N2")
  /// OS CRITERIOS DE NOTA QUE HABILITAM ESTA RODADA — os dois andam juntos.
  ///
  /// NULOS = sem filtro: e o caso da N2 e o de toda janela ja cadastrada, em que
  /// a prova cobre as disciplinas do semestre sem olhar nota nenhuma.
  ///
  /// PREENCHIDOS = so entra na prova a disciplina em que o aluno passa nos DOIS:
  /// `N1 >= notaMinimaN1` E `nota final calculada < notaMaximaFinal`. E a regra
  /// da SUBSTITUTIVA (08/09/2026): quem nao tirou o minimo na N1 ja reprovou, e
  /// quem alcancou a media na final ja passou.
  ///
  /// ⚠️ ELES NAO SAO UM INTERVALO. Ate 08/09/2026 eram (`notaMinima`/
  /// `notaMaxima`, os dois sobre a nota FINAL), e as colunas foram renomeadas
  /// junto com a regra justamente para que ninguem continue lendo o piso como
  /// piso da final — o que liberaria de novo quem tem final 2,0 com a N1 zerada.
  /// Nao ha piso na nota final, nem teto na N1.
  ///
  /// ⚠️ O gatilho e ESTE PAR, e nunca `rodada == "SUB"`: `rodada` e texto livre
  /// (quem a nomeia e a administracao), entao comparar a string faria a regra parar
  /// de valer no dia em que alguem cadastrasse "Substitutiva" ou "sub".
  notaMinimaN1    Decimal?  @db.Decimal(5, 2)
  notaMaximaFinal Decimal?  @db.Decimal(5, 2)
  descricao       String?
  aberto          Boolean   @default(false)
  dataAbertura    DateTime?
  dataFechamento  DateTime // fecha automatico quando bate esta data/hora
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// O mapa `modalidade -> periodo letivo` desta janela. Uma linha por
  /// formato cadastrado; ver `PeriodoLetivoModalidade`.
  letivosPorModalidade PeriodoLetivoModalidade[]

  /// Lado inverso de `ConfiguracaoSenhaQuiz.periodoDosDisparos`. Na pratica
  /// zero ou uma linha: a configuracao e singleton.
  disparos ConfiguracaoSenhaQuiz[]

  @@map("periodo_agendamento")
}

// ----------------------------------------------------------------------------
// O MAPA `MODALIDADE -> PERIODO LETIVO` DE UMA JANELA
// ----------------------------------------------------------------------------
//
// Existe porque a mesma prova acontece, no mesmo prazo, para alunos que estao em
// org units de Periodo Letivo DIFERENTES no Brightspace: os modulares em 2026/4
// e os presenciais em 2026/2. Sem o mapa e preciso escolher um dos dois, e a
// outra metade da universidade fica sem disciplina agendavel.
//
// POR QUE UMA TABELA, e nao duas colunas (`periodoLetivoIdModular` /
// `...Semestral`): duas colunas embutem no schema a suposicao de que existem
// exatamente duas grades e de que se sabe, aqui, qual formato cai em qual.
// Quem sabe disso e a administracao, no cadastro. Uma linha por formato tambem
// deixa o mapa APARECER na tela do admin, que e o unico jeito de um id errado
// deixar de ser invisivel.
//
// A `rodada` NAO entra aqui de proposito: as duas rodadas do mesmo periodo
// cobrem as mesmas materias, entao o mapa e da JANELA, nao da prova.
//
// ⚠️ Trocar o mapa depois de a janela ter reservas desalinha tudo, pelo mesmo
// motivo que trocar a `rodada`: `Agendamento.periodoLetivoId` e fotografia. Por
// isso ele so e editavel enquanto a janela estiver VAZIA
// (`exigirJanelaVazia`, em `periodo.service.ts`).
model PeriodoLetivoModalidade {
  id                   Int    @id @default(autoincrement())
  periodoAgendamentoId Int
  modalidadeId         Int
  /// Org unit do Periodo Letivo no Brightspace PARA ESTE FORMATO. O do aluno
  /// sai do formato do VINCULO dele, nunca do relogio.
  periodoLetivoId      String

  periodo    PeriodoAgendamento @relation(fields: [periodoAgendamentoId], references: [id], onDelete: Cascade)
  modalidade Modalidade         @relation(fields: [modalidadeId], references: [id])

  // Um formato nao pode ter dois periodos letivos na mesma janela: seria
  // impossivel dizer qual das duas arvores vale para o aluno.
  @@unique([periodoAgendamentoId, modalidadeId])
  @@index([modalidadeId])
  @@index([periodoLetivoId])
  @@map("periodo_letivo_modalidade")
}

// ----------------------------------------------------------------------------
// AGENDAMENTO COMPULSORIO — o lote que agenda por quem nao agendou
// ----------------------------------------------------------------------------
// Fechado o periodo, quem nao marcou prova E alocado pela administracao: enche a
// sala de menor `ordem` ate lotar (igual ao portal) e os dias da data mais
// proxima para a mais distante (`ordenarPorProximidade`).
//
// POR QUE ISTO E UMA TABELA, e nao uma resposta de requisicao:
//
// 1. O lote demora. Sao ~7 mil alunos e duas chamadas a Valence cada um (achar
//    o UserId, ler as disciplinas) — dezenas de minutos. Nenhum navegador nem
//    proxy segura essa conexao aberta, entao quem dispara recebe um id e volta
//    para perguntar como esta.
// 2. O resultado precisa sobreviver ao fim da execucao. "Faltaram 130 vagas em
//    Taguatinga/EAD" e a informacao que faz a administracao abrir mais uma sala; se
//    ela vivesse so na tela, sumiria no primeiro F5.
// 3. E o registro de que o compulsorio ACONTECEU, com quem mandou e quando —
//    mesma necessidade que criou o HistoricoAgendamento.
//
// SIMULACAO e o modo padrao: roda tudo, conta tudo, GRAVA NADA. Existe porque a
// pergunta "cabe todo mundo?" so tem resposta honesta depois de percorrer a
// alocacao inteira — e descobrir que nao cabe no meio de uma execucao real
// deixaria metade dos alunos alocados e a outra metade nao.

model ExecucaoCompulsorio {
  id              Int            @id @default(autoincrement())
  status          StatusExecucao @default(EM_ANDAMENTO)
  // true = nada foi gravado. O relatorio sai igual nos dois modos.
  simulacao       Boolean        @default(true)
  // O recorte, congelado no inicio: o vigente pode mudar durante a execucao.
  periodoLetivoId String
  // A rodada tambem faz parte do recorte: o lote da SUB busca quem nao tem prova
  // da SUB, e quem so agendou a N2 continua elegivel. Sem esta coluna o
  // relatorio nao diria de qual prova do semestre aquele lote foi.
  rodada          String         @default("N2")
  // Fotografia do e-mail do admin, como em HistoricoAgendamento.autor: precisa
  // continuar legivel se a conta for desativada depois.
  iniciadoPor     String

  totalElegiveis Int @default(0)
  processados    Int @default(0)
  alocados       Int @default(0)

  /// Preenchido so quando a execucao INTEIRA falha (banco fora, token vencido).
  /// Problema de UM aluno vira linha em ExcecaoCompulsorio, nunca isto.
  erro String? @db.Text

  iniciadoEm   DateTime  @default(now())
  concluidoEm  DateTime?
  // Batido a cada aluno: e assim que se distingue um lote VIVO de um que morreu
  // com o processo. Sem isto, um restart deixaria `EM_ANDAMENTO` para sempre e
  // bloquearia todo lote seguinte.
  atualizadoEm DateTime  @updatedAt

  excecoes ExcecaoCompulsorio[]

  @@index([status])
  @@map("execucao_compulsorio")
}

enum StatusExecucao {
  EM_ANDAMENTO
  CONCLUIDA
  FALHOU
}

// ----------------------------------------------------------------------------
// EXCECAO DO COMPULSORIO — quem NAO foi alocado, e por que
// ----------------------------------------------------------------------------
// A saida mais importante do lote. Alocar 4.600 pessoas nao gera trabalho para
// ninguem; os 200 que ficaram de fora sao a fila da administracao, e cada motivo
// pede uma acao diferente: SEM_VAGA abre sala, SEM_CONTA_D2L vira chamado no
// suporte do LMS, SEM_DISCIPLINA_AGENDAVEL manda conferir o CSV de turmas.
//
// Uma linha por VINCULO, nao por RA: um aluno com dois cursos pode ser alocado
// em um e ficar de fora do outro.

model ExcecaoCompulsorio {
  id         Int           @id @default(autoincrement())
  execucaoId Int
  alunoId    Int
  matricula  String // desnormalizado: o relatorio precisa dela sem join
  motivo     MotivoExcecao
  /// O texto que a administracao le ("Taguatinga / EAD: 130 sem vaga").
  detalhe    String?       @db.Text

  execucao ExecucaoCompulsorio @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  aluno    AlunoImportado      @relation(fields: [alunoId], references: [id])

  @@index([execucaoId])
  @@index([motivo])
  @@map("excecao_compulsorio")
}

enum MotivoExcecao {
  /// A matricula nao existe no Brightspace. Sem UserId nao ha disciplina.
  SEM_CONTA_D2L
  /// Duas contas com a mesma matricula: escolher uma nao e decisao nossa.
  MATRICULA_AMBIGUA
  /// UserId nao numerico — a Valence o recusaria ao ler as disciplinas.
  ID_INVALIDO_D2L
  /// Nenhuma disciplina do aluno cruzou com o CSV de turmas.
  SEM_DISCIPLINA_AGENDAVEL
  /// A janela tem filtro de nota (a substitutiva) e NENHUMA disciplina dele caiu
  /// na faixa. Nao e defeito de cadastro: e o aluno que passou, ou que ja
  /// reprovou por nota. Separado de SEM_DISCIPLINA_AGENDAVEL de proposito —
  /// aquele motivo manda a administracao conferir o CSV de turmas, e aqui nao ha
  /// nada para conferir.
  NAO_ELEGIVEL_PELA_NOTA
  /// O polo do aluno nao tem faixa cadastrada para o formato dele.
  SEM_FAIXA_NO_POLO
  /// Ha faixa, mas todas as salas do formato lotaram. Abrir mais sala.
  SEM_VAGA
  /// Cancelou e nao remarcou. Fica de fora POR DECISAO do cliente, e aparece
  /// aqui para a administracao ver quem ficou sem lugar nenhum.
  CANCELOU_E_NAO_REMARCOU
  /// A Valence falhou so para este aluno (rede, timeout). Reprocessavel.
  FALHA_NA_INTEGRACAO
  /// Alocado, mas a conta esta DESATIVADA no LMS: tem lugar na sala e nao
  /// conseguiria abrir a prova. Unico motivo que convive com uma alocacao.
  AVISO_CONTA_INATIVA_D2L
}

// ----------------------------------------------------------------------------
// SENHA DOS QUESTIONARIOS — a grade que a administração preenche, e o lote que a
// aplica no campo `Password` dos quizzes do Brightspace
// ----------------------------------------------------------------------------
// A senha e um segredo com validade de UM TURNO. A mesma turma recebe a senha de
// cada turno, e a seguinte SOBRESCREVE a anterior — isso e a FUNCIONALIDADE, nao
// um conflito: e o que impede o aluno da manha de repassar a senha para o da
// tarde.
//
// QUAIS TURMAS ENTRAM (decisao do cliente, 18/08/2026):
//
//     TurmaImportada (o CSV)  ∩  ofertas descendentes do periodo letivo vigente
//
// Todas as turmas do CSV, sem olhar se ha agendamento nelas. O cruzamento com as
// ofertas do Brightspace serve para DUAS coisas, e so elas: descobrir o
// `orgUnitId` (o CSV nao o traz) e descartar as linhas de semestres passados — a
// importacao faz upsert e NUNCA apaga, entao a tabela acumula. Oferta que existe
// no semestre e nao esta no CSV e IGNORADA: ela nao tem prova.
//
// O turno NAO seleciona turma: o conjunto e o mesmo em toda execucao. Ele so diz
// QUAL SENHA entra. Por isso nao ha coluna de turno em Faixa nem consulta a
// Agendamento aqui.

enum Turno {
  MANHA
  TARDE
  NOITE
}

enum TipoMatchQuiz {
  /// trim + igualdade.
  EXATO
  /// lowercase includes; pode casar VARIOS quizzes da mesma turma.
  CONTEM
}

enum OrigemExecucao {
  MANUAL
  CRON
}

/// O QUE aquele lote foi mexer no questionario.
///
/// Os dois compartilham TUDO — a resolucao de orgUnitId, a tabela de execucao, o
/// relatorio, o guard de "so um lote por vez". O discriminador existe porque o
/// RECORTE difere: SENHA aplica uma celula da grade em TODAS as turmas do CSV;
/// DATA aplica a janela de cada FORMATO, e por isso precisa saber o
/// formato de cada turma (derivado dos agendamentos).
///
/// ⚠️ Eles moram na MESMA tabela de proposito, e nao por economia de codigo. Os
/// dois fazem GET -> altera -> PUT no MESMO questionario, e o PUT substitui o
/// objeto inteiro. Rodando em paralelo, os dois leriam antes de qualquer um
/// gravar e o segundo PUT apagaria a alteracao do primeiro — o campo do outro
/// lote voltaria ao valor antigo, em silencio. `recusarSeJaRodando()` serializa
/// consultando ESTA tabela; com tabelas separadas ele teria de consultar as duas,
/// e esquecer isso seria exatamente o bug que ninguem ve ate o dia da prova.
enum TipoExecucaoQuiz {
  SENHA
  DATA
  /// Prepara o questionario para o SPECIAL ACCESS (15/09/2026): apaga
  /// `StartDate`/`EndDate`, liga `AllowOnlyUsersWithSpecialAccess` e tira as
  /// condicoes de liberacao por GRUPO. Grava a senha de uma celula da grade junto,
  /// pelo mesmo motivo do lote de datas. Mora aqui, e nao em
  /// `ExecucaoSpecialAccess`, porque faz PUT no MESMO questionario que os outros
  /// dois — ver o aviso acima.
  PREPARO
}

/// UMA celula da grade: dia x JANELA -> senha.
///
/// ⚠️ **A chave passou a ser a JANELA em 21/09/2026** (antes era o TURNO). O
/// motivo esta escrito no proprio seed de janelas desde 25/08/2026: com tres
/// turnos, as duas sessoes de Semi/Modular do mesmo turno dividiam a mesma
/// senha, e o aluno das 08:30 podia repassa-la ao das 10:30. Agora cada SESSAO
/// de cada FORMATO tem a sua, trocada no disparo daquela janela — o mesmo
/// calendario que ja movia a data e o grupo. Sao ~20 celulas por dia (3 no EaD,
/// 6 em Semi, 6 em Modular, 5 no Presencial) contra as 3 de antes.
///
/// ⚠️ **A senha NASCE ALEATORIA** (`senha-aleatoria.ts`): 6 digitos, nenhum
/// repetido mais de 3 vezes, unica dentro do dia. O admin deixou de digitar o
/// valor — ele manda GERAR o periodo e le o que saiu. Digitar continua possivel
/// (`definir`) como saida de emergencia, e nao como o caminho normal.
///
/// Sem linha aqui, NADA acontece naquela sessao. Esse e o humano no circuito que
/// o cron nao dispensa — e tambem por que sabado a noite (sem prova) nao precisa
/// de tratamento especial: a celula simplesmente nao existe.
model SenhaDeProva {
  id   Int      @id @default(autoincrement())
  data DateTime @db.Date

  /// A SESSAO a que esta senha pertence. A janela ja carrega o formato, as horas
  /// e o horario de disparo — e a mesma chave da grade de grupos.
  ///
  /// NULO so nas linhas ANTERIORES a 21/09/2026, que eram chaveadas por turno e
  /// ficam como historico. A grade nunca as devolve; elas sobrevivem porque a
  /// execucao daquele dia aponta para elas.
  janelaDeProvaId Int?

  /// O turno da celula no desenho ANTIGO (ate 21/09/2026). Nulo em toda linha
  /// nova. Mantido para as linhas historicas continuarem legiveis sozinhas —
  /// mesma razao de `ExecucaoSenhaQuiz.turno` ser desnormalizado.
  turno Turno?

  /// TEXTO CLARO, e nao ha alternativa: o D2L exige o valor literal no PUT e a
  /// administracao imprime a folha para os fiscais. Hash impossibilitaria as duas.
  ///
  /// Esta e a UNICA coluna do banco com o valor. Ele NAO entra em
  /// ExecucaoSenhaQuiz, ItemSenhaQuiz, auditoria, log, CSV nem na listagem da
  /// grade — so nas rotas de revelar, que sao auditadas.
  senha String @db.VarChar(200)

  /// Sobe 1 a cada troca do VALOR (nao a cada PUT).
  ///
  /// Responde a pergunta operacional real — "gerei de novo as 07:20, o cron ja
  /// tinha rodado as 07:30?" — comparando com ExecucaoSenhaQuiz.versaoAplicada,
  /// SEM guardar a senha anterior em lugar nenhum. Um hash da senha aplicada
  /// resolveria o mesmo e seria forcavel por dicionario (sao 6 digitos); o
  /// contador nao expoe nada.
  versao Int @default(1)

  /// Fotografia do e-mail, como HistoricoAgendamento.autor: precisa continuar
  /// legivel se a conta do admin for desativada depois. `"gerador"` quando a
  /// linha nasceu de uma geracao em lote pedida na tela.
  criadoPor     String
  atualizadoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// CASCADE, como em `GrupoDaJanela`: a sessao removida do calendario nao tem
  /// mais senha a que se aplicar. A execucao historica sobrevive pelo outro
  /// caminho (`onDelete: SetNull` + data/turno desnormalizados na execucao).
  janelaDeProva JanelaDeProva?      @relation(fields: [janelaDeProvaId], references: [id], onDelete: Cascade)
  execucoes     ExecucaoSenhaQuiz[]

  /// A chave de hoje. O MySQL nao conflita NULLs, entao as linhas historicas
  /// (janela nula) convivem aqui sem colidir umas com as outras.
  @@unique([data, janelaDeProvaId])
  /// A chave ANTIGA, preservada para as linhas historicas. Toda linha nova tem
  /// `turno` nulo e por isso nunca esbarra nela.
  @@unique([data, turno])
  @@index([data])
  @@index([janelaDeProvaId])
  @@map("senha_de_prova")
}

/// O que o admin configura do lote: QUAL questionario procurar e A QUE HORAS o
/// cron aplica cada turno. Linha unica (id = 1), mesmo idioma de IntegracaoD2L.
///
/// Fica no BANCO e nao no .env porque as duas coisas mudam por semestre — o nome
/// da prova ("Prova N2 2026/1") e o calendario dos turnos — e quem sabe os dois
/// e a administracao, que nao faz deploy. Nada aqui tem semente no .env: um valor
/// que "ja vem preenchido" e um lote que roda com o alvo errado calado.
model ConfiguracaoSenhaQuiz {
  id Int @id @default(1)

  /// NULO enquanto ninguem escolheu. O lote RECUSA comecar assim: um nome
  /// chutado casaria com o questionario errado em toda turma do CSV de uma vez.
  nomeQuiz  String?
  matchQuiz TipoMatchQuiz @default(CONTEM)

  // ⚠️ `horaManha`/`horaTarde`/`horaNoite` SAIRAM em 21/09/2026. Eram os tres
  // horarios de turno do cron de senhas; agora a senha troca no disparo da
  // JANELA, junto com a data e o grupo, e quem diz a que horas isso acontece e
  // `JanelaDeProva.horaDisparo`. Manter as colunas mortas seria manter dois
  // calendarios, e o errado e o que alguem acabaria editando.

  /// O PERIODO DE AGENDAMENTO QUE OS DISPAROS USAM — senhas, datas, grupos e
  /// acesso especial, manuais e do cron (23/09/2026).
  ///
  /// NULO = o vigente (o cadastrado mais recentemente), que era a unica opcao
  /// antes desta coluna. Preenchido = aquele periodo, mesmo que outro tenha sido
  /// cadastrado depois: cadastrar o proximo semestre com antecedencia nao pode
  /// mudar as turmas e os alunos que o cron vai tocar no dia seguinte.
  ///
  /// RESTRICT, e nao SetNull: apagar o periodo escolhido voltaria os disparos ao
  /// vigente em silencio — exatamente o sintoma que a coluna existe para evitar.
  /// `PeriodoService.remover` recusa antes, com a frase de como destravar.
  periodoDosDisparosId  Int?
  periodoDosDisparos    PeriodoAgendamento? @relation(fields: [periodoDosDisparosId], references: [id], onDelete: Restrict)
  /// Quem escolheu e quando — separados de `atualizadoPor`/`atualizadoEm`,
  /// que sao do questionario-alvo: a tela mostra os dois, e um autor so
  /// atribuiria a troca de um a quem mexeu no outro.
  periodoDosDisparosPor String?
  periodoDosDisparosEm  DateTime?

  atualizadoPor String?
  atualizadoEm  DateTime @updatedAt

  @@index([periodoDosDisparosId])
  @@map("configuracao_senha_quiz")
}

/// UMA rodada do lote. Molde: ExecucaoCompulsorio — POST volta na hora com o id,
/// GET acompanha, e `atualizadoEm` e o sinal de vida que distingue lote lento de
/// lote que morreu com o processo.
model ExecucaoSenhaQuiz {
  id          Int            @id @default(autoincrement())
  status      StatusExecucao @default(EM_ANDAMENTO)
  /// true = nenhum PUT sai daqui. E o PADRAO, como no compulsorio.
  simulacao   Boolean        @default(true)
  origem      OrigemExecucao @default(MANUAL)
  /// e-mail do admin, ou "cron".
  iniciadoPor String

  /// SENHA ou DATA. `@default(SENHA)` e o que classifica as execucoes que ja
  /// existiam quando esta coluna nasceu — elas eram todas de senha.
  tipo TipoExecucaoQuiz @default(SENHA)

  /// A celula da grade cuja senha foi aplicada.
  ///
  /// FK OPCIONAL de proposito: apagar a senha antiga (retencao) NAO pode apagar
  /// a prova de que o lote rodou. Por isso data/turno tambem sao desnormalizados.
  ///
  /// Preenchida em `SENHA` **e em `DATA`** — desde 25/08/2026 o lote de datas
  /// grava a senha junto, porque o PUT substitui o questionario inteiro. NULA so
  /// em `PREPARO`, de proposito: um preparo nao pode passar por troca de senha
  /// para o cron nem para a trava de "esta celula ja foi aplicada".
  senhaDeProvaId  Int?
  /// O DIA que o lote mirou — o dia da PROVA, ja com o `diaSeguinte` aplicado
  /// quando a janela e a que arma a manha seguinte.
  data            DateTime @db.Date
  /// O turno da SESSAO, como rotulo legivel do relatorio e do log. Nulo nas
  /// execucoes anteriores a 21/09/2026 que eram de DATA (ali o turno era a chave
  /// da grade de senhas, e uma execucao de datas nao pertencia a um turno).
  turno           Turno?
  periodoLetivoId String

  /// A janela aplicada.
  ///
  /// ⚠️ Desde 21/09/2026 ela e preenchida **tambem em `SENHA`**: a senha passou
  /// a ser trocada por sessao, no disparo da janela, e nao mais tres vezes por
  /// dia. Quem le esta coluna para decidir idempotencia PRECISA filtrar por
  /// `tipo` — sem isso, a troca de senha das 12:01 faria a troca de data das
  /// 12:01 parecer ja aplicada.
  ///
  /// NULA em `PREPARO`. FK opcional pelo mesmo motivo de `senhaDeProvaId`:
  /// apagar uma janela do calendario nao pode apagar a prova de que o lote
  /// rodou. Por isso as horas tambem sao desnormalizadas abaixo.
  janelaDeProvaId    Int?
  /// Congeladas no inicio, como `nomeQuizAlvo`: a janela pode ser editada na tela
  /// durante a execucao, e o registro precisa dizer o que REALMENTE foi aplicado.
  /// Nulas em `SENHA` e `PREPARO` — os dois nao movem o calendario do
  /// questionario, mesmo o de senha ja sabendo de qual sessao a senha saiu.
  horaInicioAplicada String? @db.VarChar(5)
  horaFimAplicada    String? @db.VarChar(5)

  /// Congelados no inicio: a celula e a configuracao podem ser editadas durante
  /// a execucao, e o registro precisa dizer o que REALMENTE foi aplicado.
  ///
  /// Em `SENHA` e a versao da CELULA; em `DATA`, a da JANELA. Nos dois casos
  /// responde a mesma pergunta — "qual versao da configuracao foi realmente
  /// aplicada?" —, e e o que faz a idempotencia do cron liberar um novo disparo
  /// quando o admin corrige o horario ou gera a senha de novo.
  ///
  /// ⚠️ Por guardar coisas diferentes nos dois tipos, ela **so tem sentido ao
  /// lado de um filtro por `tipo`**. Desde 21/09/2026 as duas execucoes do mesmo
  /// minuto compartilham `janelaDeProvaId`, e sem o filtro a versao da celula de
  /// uma poderia casar por acaso com a versao da janela da outra.
  versaoAplicada Int?

  /// A versao da CELULA da grade, sempre — inclusive nas execucoes `DATA`.
  ///
  /// ⚠️ Nasceu em 21/09/2026 porque `versaoAplicada` guarda coisas diferentes
  /// nos dois tipos: a da celula em `SENHA`, a da JANELA em `DATA`. A grade
  /// precisa responder "o Brightspace esta com a senha que estou vendo?", e
  /// desde que o lote de datas tambem grava a senha, a resposta tem de sair de
  /// QUALQUER execucao que a tenha aplicado. Comparar com `versaoAplicada` de
  /// uma execucao `DATA` compararia a versao da celula com a da janela — dois
  /// contadores sem relacao, e a grade diria "desatualizada" no dia em que eles
  /// se cruzassem.
  ///
  /// Entra tambem na idempotencia do lote de DATAS: gerar a senha de novo as
  /// 12:43, depois do disparo das 12:01, precisa liberar um novo disparo HOJE —
  /// o questionario esta com a senha antiga. Mesmo remedio do bug de
  /// 25/08/2026, aplicado ao terceiro campo que o disparo grava.
  ///
  /// NULA em `PREPARO` (que nao conta como troca de senha) e em toda execucao
  /// anterior a 21/09/2026.
  versaoSenhaAplicada Int?
  nomeQuizAlvo        String
  matchQuizAlvo       TipoMatchQuiz

  /// Fase 1 — resolucao do orgUnitId das turmas do CSV.
  turmasNoCsv        Int @default(0)
  turmasResolvidas   Int @default(0)
  /// Quantos orgUnitId foram aprendidos NESTA execucao. Sinal de CSV novo.
  orgUnitsAprendidos Int @default(0)

  /// Fase 1b, so em `DATA` — quantas turmas resolvidas ficaram DE FORA porque o
  /// formato nao pode ser derivado dos agendamentos.
  ///
  /// Sao os dois contadores mais importantes do lote de datas, e pelo mesmo
  /// motivo de `naoEncontradas`: nao sao falha de rede nem erro de ninguem, e
  /// cada um e uma turma inteira que ficaria com a data velha — ou seja, alunos
  /// que nao abrem a prova. Zero falhas com 30 aqui e um desastre silencioso.
  semModalidade     Int @default(0)
  modalidadeAmbigua Int @default(0)

  /// Fase 2 — os quizzes.
  processadas    Int @default(0)
  definidas      Int @default(0)
  naoEncontradas Int @default(0)
  falhas         Int @default(0)

  /// Fase 2b, so em `DATA` com grupo configurado na janela — a troca da condicao
  /// de liberacao do questionario.
  ///
  /// ⚠️ `gruposPendentes` tem o MESMO peso de `naoEncontradas` e `semModalidade`
  /// na tela. Cada unidade aqui e uma prova que vai abrir no horario certo para
  /// o grupo da sessao ANTERIOR — o aluno que ja fez a prova as 15h consegue
  /// abri-la de novo as 19h, que e exatamente o que este recurso existe para
  /// impedir. Uma execucao com 0 falhas e 30 aqui NAO e verde.
  ///
  /// Como cada turma ja tem TODOS os grupos criados (decisao do cliente), este
  /// contador em zero e o estado normal: qualquer valor acima disso e anomalia
  /// de cadastro, nao operacao de rotina.
  gruposTrocados  Int @default(0)
  gruposPendentes Int @default(0)

  /// A celula da GRADE DE GRUPOS usada, e a versao dela. NULAS quando o grupo
  /// veio do nome fixo da janela, ou quando nao houve grupo.
  ///
  /// ⚠️ Entram na chave da idempotencia junto com `versaoAplicada` (a da
  /// janela). Sem elas, corrigir o grupo de hoje depois do disparo nao
  /// liberaria nada: a janela nao mudou, e a execucao concluida bloquearia o
  /// novo disparo em silencio — o bug de 25/08/2026 num campo novo.
  grupoDaJanelaId     Int?
  versaoGrupoAplicada Int?
  /// O nome que esta execucao aplicou — congelado, como `horaInicioAplicada`.
  /// Antes da grade ele era lido da JANELA na hora de exibir, o que so funcionava
  /// porque o nome nunca mudava; com um nome por dia, o relatorio de ontem
  /// mostraria o grupo de hoje.
  nomeGrupoAplicado   String? @db.VarChar(200)

  /// Quantos GETs devolveram `Password` PREENCHIDO.
  ///
  /// Zero com itens > 0 significa que a API esconde o campo (o QuizReadData so o
  /// expoe se "nao nulo E visivel ao contexto do chamador").
  ///
  /// ⚠️ Aqui isso e INFORMATIVO, nao salvaguarda. No CLI de origem havia risco
  /// real, porque ele PRESERVAVA a senha lida e um GET nulo apagaria tudo em
  /// silencio. Este lote sempre DEFINE uma senha nova — nunca preserva, nunca
  /// remove. NAO construa regra de negocio em cima deste contador.
  comSenhaLida Int @default(0)

  /// So quando a execucao INTEIRA falha (banco fora, token vencido). Problema de
  /// UMA turma vira linha em ItemSenhaQuiz, nunca isto.
  erro String? @db.Text

  iniciadoEm   DateTime  @default(now())
  concluidoEm  DateTime?
  /// Batido a cada fatia. Sem isto, um restart deixaria `EM_ANDAMENTO` para
  /// sempre e bloquearia todo lote seguinte.
  atualizadoEm DateTime  @updatedAt

  senhaDeProva  SenhaDeProva?   @relation(fields: [senhaDeProvaId], references: [id], onDelete: SetNull)
  janelaDeProva JanelaDeProva?  @relation(fields: [janelaDeProvaId], references: [id], onDelete: SetNull)
  grupoDaJanela GrupoDaJanela?  @relation(fields: [grupoDaJanelaId], references: [id], onDelete: SetNull)
  itens         ItemSenhaQuiz[]

  /// A consulta de idempotencia do cron: "esta celula ja foi aplicada de verdade?"
  @@index([data, turno, simulacao, status])
  /// A mesma pergunta do lado das datas: "esta janela ja foi aplicada hoje?".
  /// `data` entra porque a janela se repete todo dia — sem ela, aplicar a janela
  /// das 15:00 numa segunda impediria a de terca.
  @@index([janelaDeProvaId, data, simulacao, status])
  @@index([status])
  /// `ultima(origem, tipo)`, consultada em laco por toda tela aberta.
  @@index([tipo, origem, id])
  @@map("execucao_senha_quiz")
}

enum ResultadoSenhaQuiz {
  DEFINIDA
  /// Dry-run: casou e teria sido definida.
  SIMULADA
  /// A turma nao tem quiz com o nome configurado. **A saida mais importante do
  /// lote**: e uma turma inteira de alunos que nao conseguiria abrir a prova, e
  /// nao aparece como "falha" nenhuma.
  QUIZ_NAO_ENCONTRADO
  /// Linha do CSV que nenhuma oferta do semestre casou. Nao e falha de rede: e
  /// planilha desatualizada, ou `Code` divergente no Brightspace.
  ORGUNIT_NAO_RESOLVIDO
  /// Duas ofertas casaram a mesma linha. NAO se escolhe uma: alguem decide.
  ORGUNIT_AMBIGUO

  /// So em execucoes `DATA`. Nenhum agendamento CONFIRMADO aponta para esta
  /// turma no periodo+rodada vigentes, entao nao ha de onde derivar o formato
  /// — e sem formato nao ha janela. Ou ninguem agendou ainda, ou a turma do
  /// CSV nao tem prova nesta rodada.
  SEM_AGENDAMENTO

  /// So em execucoes `DATA`. Alunos de DOIS formatos diferentes tem prova
  /// nesta turma, e o questionario tem UMA janela so. Escolher a maioria
  /// deixaria a minoria sem conseguir abrir a prova, e o erro so apareceria no
  /// dia — entao nada e gravado. Mesma regra de ORGUNIT_AMBIGUO.
  MODALIDADE_AMBIGUA

  FALHA_AO_LISTAR
  FALHA_AO_LER
  FALHA_AO_GRAVAR
}

/// O desfecho da troca do GRUPO que libera a prova — a condicao `EnrolledInGroup`
/// do questionario.
///
/// ⚠️ **E um enum SEPARADO de `ResultadoSenhaQuiz`, de proposito.** Sao dois
/// desfechos independentes na mesma linha: a data pode ter sido `DEFINIDA` com o
/// grupo pendente, e e assim que o cliente pediu (decisao de 26/08/2026). Sem a
/// data a prova nao abre para NINGUEM; sem a troca de grupo ela abre para o grupo
/// anterior. Fundir os dois enums forcaria escolher qual dos dois problemas
/// reportar, e o relatorio perderia justamente o caso misto.
enum ResultadoGrupoQuiz {
  TROCADO
  /// Dry-run: o grupo foi resolvido, a condicao casou e teria sido trocada.
  SIMULADO
  /// A condicao ja apontava para o grupo-alvo. Nao e erro — acontece ao
  /// reprocessar a mesma janela, e vale marcar para o relatorio nao parecer
  /// que houve troca onde nao houve.
  JA_ERA_O_GRUPO

  /// O questionario nao tem nenhuma condicao `EnrolledInGroup` para trocar.
  ///
  /// ⚠️ **Nada e criado.** Adicionar uma condicao de liberacao onde nao havia
  /// mudaria o comportamento de uma prova que talvez fosse aberta a todos de
  /// proposito — e o PUT substitui a lista INTEIRA de condicoes, entao criar
  /// implicaria reescrever o que nao se sabe ler. Vira linha de pendencia.
  SEM_CONDICAO_DE_GRUPO

  /// A condicao existe, mas por CATEGORIA (`GroupCategoryId` preenchido em vez
  /// de `GroupId`). Isso significa "qualquer grupo da categoria": trocar mudaria
  /// o SIGNIFICADO da condicao, nao o alvo dela. Preservada.
  CONDICAO_POR_CATEGORIA

  /// O nome cadastrado na janela nao existe entre os grupos da turma.
  ///
  /// ⚠️ Como toda turma ja tem todos os grupos criados, isto e ANOMALIA DE
  /// CADASTRO: nome digitado errado na tela, ou grupo que faltou ser criado
  /// naquela turma. O `detalhe` do item lista os grupos que existem.
  GRUPO_NAO_ENCONTRADO

  /// O mesmo nome aparece em duas categorias da turma. NAO se escolhe uma: o
  /// homonimo errado liberaria a prova para o turno errado, e o erro so
  /// apareceria no dia. Preencha `categoriaGrupo` na janela para desempatar.
  GRUPO_AMBIGUO

  /// A turma nao tem nenhuma categoria de grupo — nao ha onde procurar.
  SEM_CATEGORIA_DE_GRUPO

  /// A janela usa a GRADE DE GRUPOS, e o dia da prova ficou em branco — sem
  /// celula e sem nome fixo na janela (14/09/2026).
  ///
  /// Nenhuma chamada de grupo sai: nao ha nome a procurar. E pendencia, e nao
  /// "nao troca", porque a condicao continua apontando para o grupo da sessao
  /// ANTERIOR — e calar aqui faria o dia esquecido parecer um disparo limpo.
  SEM_GRUPO_NO_DIA

  FALHA_AO_LER_CONDICOES
  FALHA_AO_GRAVAR_CONDICOES

  /// So no PREPARO: as condicoes `EnrolledInGroup` foram retiradas. As de outros
  /// tipos voltaram verbatim.
  REMOVIDO
  /// So no PREPARO, em simulacao: havia condicao de grupo e ela teria sido retirada.
  REMOCAO_SIMULADA
}

/// Uma linha por (turma, quiz casado). Turma sem quiz casado gera UMA linha
/// QUIZ_NAO_ENCONTRADO; turma que nao resolveu o orgUnitId gera UMA linha
/// ORGUNIT_NAO_RESOLVIDO.
model ItemSenhaQuiz {
  id         Int @id @default(autoincrement())
  execucaoId Int

  /// Nulo quando a resolucao falhou — e justamente o caso que o relatorio existe
  /// para mostrar.
  orgUnitId      String?
  /// Desnormalizados: o CSV do relatorio precisa deles sem join.
  codigoTurma    String?
  nomeDisciplina String?

  quizId   String?
  nomeQuiz String?

  resultado ResultadoSenhaQuiz

  /// O GET devolveu `Password` preenchido? **Nunca o valor** — ver a regra 2 da
  /// postura de seguranca no cabecalho de senha-quiz.service.ts.
  senhaAnteriorLida Boolean @default(false)

  /// So em execucoes `DATA`. O codigo do formato DERIVADO para esta turma
  /// ("EAD", "SEMI", ...). Guardado como texto, e nao como FK, pelo mesmo motivo
  /// de `codigoTurma`: o CSV do relatorio precisa dele sem join. Nulo quando a
  /// derivacao falhou — que e justamente o caso que o relatorio existe para
  /// mostrar.
  modalidadeCodigo String?

  /// So em execucoes `DATA`: a janela que o questionario passou a ter, em UTC —
  /// o mesmo instante que foi para o `StartDate`/`EndDate` do PUT.
  ///
  /// Existe para responder "por que a prova abriu as 16h?" depois, com o cliente
  /// na frente, mesmo que a janela ja tenha sido editada na tela. Fotografia,
  /// como `AgendamentoDisciplina.notaFinal`.
  startDateAplicado DateTime?
  endDateAplicado   DateTime?

  /// So em execucoes `DATA` cuja janela tem `nomeGrupo`. NULO significa "a troca
  /// de grupo nem foi tentada nesta linha" — janela sem grupo cadastrado, ou
  /// linha que nem chegou ao questionario (orgUnit nao resolvido, formato
  /// ambiguo). Nao confunda com um desfecho ruim: aqui ausencia e ausencia.
  resultadoGrupo ResultadoGrupoQuiz?

  /// O grupo que a condicao apontava ANTES, no formato "Prova 1 (#156988)".
  ///
  /// O nome vem do mapa que a resolucao ja carregou para a turma; quando o id
  /// nao esta nesse mapa (grupo de outra categoria, por exemplo) sobra so
  /// "#156988". Um numero solto no relatorio nao responde "de qual sessao a
  /// prova estava liberada?", que e a pergunta que se faz com o cliente na frente.
  grupoAnterior String?
  grupoAplicado String?

  /// Fotografia do GET das condicoes ANTES da troca, verbatim.
  ///
  /// ⚠️ **E a unica forma de voltar atras.** O PUT de `conditionalRelease`
  /// substitui a lista INTEIRA de condicoes e a API nao guarda historico: sem
  /// isto, uma troca errada nao tem desfazer. O CLI de origem grava o mesmo JSON
  /// em `logs/backup/` antes de qualquer escrita, inclusive no dry-run; aqui ele
  /// fica no banco, ao lado da execucao que o produziu.
  ///
  /// Gravado tambem na SIMULACAO, pelo mesmo motivo que la: e no dry-run que se
  /// descobre o que a prova tem hoje.
  condicoesAnteriores String? @db.Text

  detalhe String? @db.Text

  execucao ExecucaoSenhaQuiz @relation(fields: [execucaoId], references: [id], onDelete: Cascade)

  @@index([execucaoId])
  @@index([resultado])
  @@map("item_senha_quiz")
}

// ----------------------------------------------------------------------------
// JANELA DE PROVA — a que horas o questionario abre e fecha, por FORMATO
// ----------------------------------------------------------------------------
//
// Uma linha = um DISPARO. `horaDisparo` diz quando o cron aplica; `horaInicio` e
// `horaFim` sao o StartDate e o EndDate que o questionario passa a ter. No dia
// da prova o questionario fica aberto SO durante a sessao corrente, e a senha da
// grade continua sendo o segundo fator.
//
// POR QUE POR FORMATO: a duracao da prova vem dele (EaD 3h, Semi/Modular 1h30
// — ver `Modalidade.duracaoMinutos`), entao EaD cabe em 3 sessoes por dia e
// Semi/Modular em 6. Nao ha um calendario unico possivel.
//
// POR QUE NO BANCO, E NAO CONSTANTE NO CODIGO: mesmo caminho que
// `ConfiguracaoSenhaQuiz.horaManha/Tarde/Noite` seguiu em 19/08/2026, e pelo
// mesmo motivo — quem conhece o calendario e a administração, que nao faz deploy.
// Diferenca deliberada em relacao aquela tabela: AQUI HA SEED. O alvo do quiz
// nao podia ter default (um nome plausivel casaria com o questionario errado em
// silencio), mas um horario errado nao "casa" com nada: ou o admin o corrige na
// tela, ou o dry-run o mostra. O custo de nao semear seria pior — um ambiente
// novo subiria sem janela nenhuma e o cron nunca dispararia.
//
// O par (`horaInicio`, `horaFim`) NAO e derivado de `Faixa`. As faixas de hoje
// batem com estes horarios, mas faixa e polo+sala+vaga: um dia sem faixa
// cadastrada deixaria o questionario sem janela, e a prova nao abriria.
model JanelaDeProva {
  id           Int    @id @default(autoincrement())
  modalidadeId Int
  /// Sequencia da janela DENTRO do formato. Nao e ordem cronologica do dia:
  /// a janela que dispara as 22:01 e a primeira (ela arma a prova das 09:00 de
  /// amanha) e mesmo assim e a ultima do relogio.
  ordem        Int
  /// "HH:MM" em America/Sao_Paulo, quando o cron aplica. Ver `janela.ts`.
  horaDisparo  String @db.VarChar(5)
  /// "HH:MM" — vira o `StartDate` do questionario, convertido para UTC-Z.
  horaInicio   String @db.VarChar(5)
  /// "HH:MM" — vira o `EndDate`.
  horaFim      String @db.VarChar(5)

  /// O TURNO em que esta sessao acontece. Hoje e so um ROTULO — de manha, de
  /// tarde ou a noite — usado na tela, no log e na auditoria.
  ///
  /// ⚠️ **Ate 21/09/2026 ele decidia de qual celula da grade saia a senha**, e
  /// era por isso que ele existia: o PUT substitui o questionario inteiro e
  /// precisa reenviar `Password`, e o GET pode devolver `Password: null` num
  /// questionario que TEM senha. Com a grade de senhas passando a ser chaveada
  /// pela propria janela, cada sessao le a SUA celula e este campo parou de
  /// decidir qualquer coisa — inclusive o efeito colateral que a decisao de
  /// 25/08/2026 aceitava, de duas sessoes seguidas do mesmo turno dividirem a
  /// mesma senha.
  ///
  /// Continua GRAVADO porque o rotulo tem uso proprio (a tela agrupa as sessoes
  /// por turno, e "a janela da manha nao rodou" e como a administracao fala), e
  /// porque tira-lo mexeria em telas e no lote de grupos sem nada em troca.
  turno Turno

  /// O disparo aponta para AMANHA, nao para hoje.
  ///
  /// E o ultimo disparo do dia: ele fecha a noite armando a PRIMEIRA sessao da
  /// manha seguinte. Sem esta coluna, a janela das 08:30 teria de ser aplicada
  /// de madrugada — um disparo a mais, num horario em que ninguem esta olhando
  /// se ele falhou.
  ///
  /// ⚠️ **DERIVADO, nao configurado** (25/08/2026). Vale exatamente
  /// `horaDisparo > horaInicio`: se o disparo acontece depois da hora de
  /// abertura, ele nao PODE ser para hoje — nao da para abrir uma prova as 08:30
  /// quando ja sao 22:01. Foi um checkbox na tela por um dia, e nao havia
  /// resposta certa que o admin pudesse dar; marcar "hoje" ali produzia uma prova
  /// que abre no passado, que a API aceita e nasce fechada.
  ///
  /// Fica GRAVADO mesmo sendo derivado, como `AlunoImportado.ativo`: e o que faz
  /// a tabela ser legivel sozinha e o que o cron le sem recalcular. O calculo
  /// roda em toda escrita (`salvarJanelas` e o seed), entao so um UPDATE manual
  /// no banco desalinharia. A regra vive em `ehDoDiaSeguinte` (`janela.ts`).
  diaSeguinte Boolean @default(false)

  /// O NOME do grupo, no Brightspace, que passa a liberar a prova quando ESTA
  /// janela dispara.
  ///
  /// ⚠️ **Nao e um grupo unico com os alunos trocados a cada sessao**: cada
  /// turma tem UM GRUPO POR SESSAO — "Prova 1", "Prova 2", "Prova 3"… — e o que
  /// o disparo troca e o grupo APONTADO pela condicao, nao o conteudo dele. O
  /// numero de grupos por turma cai do formato, como as janelas: 3 no EaD, 6
  /// em Semi/Modular, 5 no Presencial. Sao ~14 nomes no total, um por janela.
  ///
  /// ⚠️ **Desde 14/09/2026 e o PADRAO, nao a regra.** O nome de cada DIA vem da
  /// grade `GrupoDaJanela`; este campo so vale nos dias sem celula. Ele nasceu
  /// "fixo por janela e reusado nos seis dias" (26/08/2026), e a operacao real
  /// mostrou grupos com nomes proprios por dia. Ver `grupo-do-dia.ts`.
  ///
  /// ⚠️ **Guarda o NOME, nunca o `GroupId`.** Cada turma tem os seus proprios
  /// grupos, com ids proprios, mesmo com nomes identicos: "Prova 2" existe em
  /// todas as turmas com um id diferente em cada. O id e resolvido turma a turma
  /// no momento do disparo (`resolucao-grupo.service.ts`). Gravar um id aqui
  /// liberaria a prova de 156 turmas para um grupo que so existe numa.
  ///
  /// ⚠️ **NULO = a troca de grupo nao acontece nesta janela**, e o lote de datas
  /// se comporta exatamente como antes. E o que mantem o recurso opt-in por
  /// formato e o que deixa o Presencial (que ainda nao tem aluno importado)
  /// sem efeito colateral nenhum.
  ///
  /// NAO tem semente. Mesmo argumento de `ConfiguracaoSenhaQuiz.nomeQuiz`: um
  /// NOME chutado casa com o grupo errado em silencio, enquanto a ausencia
  /// apenas nao troca nada e aparece no dry-run.
  nomeGrupo String? @db.VarChar(200)

  /// A categoria de grupo onde procurar, para desempatar homonimos.
  ///
  /// Opcional, e quando informada tambem BARATEIA a resolucao: busca-se numa
  /// categoria so, em vez de listar os grupos de todas. Sem ela, o mesmo nome em
  /// duas categorias e recusado como `GRUPO_AMBIGUO` — escolher no chute
  /// liberaria a prova para o turno errado sem ninguem perceber.
  categoriaGrupo String? @db.VarChar(200)

  /// Desligar a janela sem apagar a linha, para nao perder o horario cadastrado
  /// quando um semestre tiver menos sessoes que o outro.
  ativo Boolean @default(true)

  /// Sobe 1 a cada mudanca de HORARIO (nao a cada save).
  ///
  /// ⚠️ Gemea de `SenhaDeProva.versao`, e nasceu do mesmo bug — que aconteceu de
  /// verdade em 25/08/2026. A idempotencia do cron pergunta "esta janela ja
  /// rodou hoje?", e o `upsert` de `salvarJanelas` PRESERVA o id da linha. Sem a
  /// versao, corrigir o horario de uma janela que ja disparou no mesmo dia nao a
  /// libera: o cron encontra a execucao concluida daquele id e pula, EM
  /// SILENCIO. O admin salva as 12:43, espera as 12:45 e nao acontece nada — e
  /// so no dia seguinte funciona.
  ///
  /// Sobe so quando o horario MUDA (nao em todo PUT) pelo mesmo motivo da senha:
  /// salvar de novo o mesmo calendario nao pode fazer o lote inteiro rodar outra
  /// vez em toda a instituicao.
  ///
  /// ⚠️ **`nomeGrupo` e `categoriaGrupo` contam como mudanca** (26/08/2026). Sao
  /// campos que o disparo APLICA, exatamente como as horas, e um nome de grupo
  /// digitado errado tem a mesma cara do bug de 25/08/2026: o admin corrige as
  /// 12:43 depois do disparo das 12:01, o `upsert` preserva o id, a idempotencia
  /// encontra a execucao concluida e pula EM SILENCIO — a correcao so valeria no
  /// dia seguinte. `ativo` continua nao contando: religar uma sessao nao muda o
  /// que ela grava.
  versao Int @default(1)

  /// Fotografia do e-mail, como em `SenhaDeProva.atualizadoPor`.
  atualizadoPor String?
  atualizadoEm  DateTime @updatedAt

  modalidade Modalidade @relation(fields: [modalidadeId], references: [id])

  execucoes   ExecucaoSenhaQuiz[]
  gruposDoDia GrupoDaJanela[]
  senhasDoDia SenhaDeProva[]

  @@unique([modalidadeId, ordem])
  @@index([modalidadeId])
  @@map("janela_de_prova")
}

// ----------------------------------------------------------------------------
// A GRADE DE GRUPOS — dia x janela -> nome do grupo (14/09/2026)
// ----------------------------------------------------------------------------
//
// REVERTE a decisao 1 de 26/08/2026 ("o nome do grupo e FIXO POR JANELA e
// reusado nos seis dias"). Na operacao real os grupos de cada dia de prova tem
// nomes proprios e LIVRES, e a administracao passou a trocar `nomeGrupo` da janela
// a mao todo dia — exatamente o trabalho que o disparo automatico existia para
// tirar dela, com o risco extra de esquecer a troca de um dia.
//
// E a mesma forma da grade de SENHAS, com outra chave: la e dia x TURNO, aqui e
// dia x JANELA. Nao da para reusar o turno: em Semi/Modular sao seis janelas e
// tres turnos, e cada SESSAO tem o seu grupo.
//
// COMO O DISPARO ESCOLHE O GRUPO (`grupo-do-dia.ts`, pura e testada):
//
//   1. ha celula para (dia, janela)            -> o nome da celula;
//   2. nao ha, mas a janela tem `nomeGrupo`    -> o nome fixo, como antes;
//   3. nao ha nenhum dos dois, e a janela JA
//      USOU a grade em algum dia               -> PENDENCIA (`SEM_GRUPO_NO_DIA`)
//                                                em cada questionario;
//   4. nunca teve grupo nenhum                 -> nao troca grupo, como antes.
//
// O caso 3 e o que impede o esquecimento de passar calado: sem ele, o dia que
// ficou em branco abriria a prova para o grupo da sessao ANTERIOR, com a
// execucao verde.
//
// Nao ha segredo aqui (nome de grupo nao e senha), entao nao ha rota de revelar
// nem auditoria de leitura — so de escrita, porque decide para quem a prova abre.
model GrupoDaJanela {
  id              Int      @id @default(autoincrement())
  /// O dia da PROVA — o mesmo `data` que a execucao grava, ja com o
  /// `diaSeguinte` resolvido. A janela das 22:01 de segunda le a celula de TERCA.
  data            DateTime @db.Date
  janelaDeProvaId Int

  /// O NOME, nunca o `GroupId` — mesmo motivo de `JanelaDeProva.nomeGrupo`: cada
  /// turma tem os seus grupos, com ids proprios. Nunca vazio: celula apagada na
  /// tela e linha REMOVIDA, e nao string vazia.
  nomeGrupo      String  @db.VarChar(200)
  /// Opcional. NULO = usa a categoria da janela.
  categoriaGrupo String? @db.VarChar(200)

  /// Sobe quando o nome ou a categoria MUDAM. Gemea de `SenhaDeProva.versao`, e
  /// pelo mesmo bug de 25/08/2026: corrigir o grupo de hoje depois do disparo
  /// das 12:01 precisa liberar a janela para rodar de novo HOJE. A execucao
  /// guarda a celula e esta versao (`grupoDaJanelaId` + `versaoGrupoAplicada`),
  /// e a idempotencia compara as duas.
  versao Int @default(1)

  /// Fotografia do e-mail, como em `SenhaDeProva`.
  criadoPor     String
  atualizadoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// CASCADE: `salvarJanelas` remove a sessao que saiu do calendario, e a grade
  /// dela nao teria a que se aplicar. A execucao historica sobrevive por outro
  /// caminho (`onDelete: SetNull` + `nomeGrupoAplicado` desnormalizado).
  janelaDeProva JanelaDeProva       @relation(fields: [janelaDeProvaId], references: [id], onDelete: Cascade)
  execucoes     ExecucaoSenhaQuiz[]

  @@unique([data, janelaDeProvaId])
  @@index([janelaDeProvaId])
  @@map("grupo_da_janela")
}

// ----------------------------------------------------------------------------
// O FORMATO QUE O ADMIN DECIDIU — o desempate da turma ambigua
// ----------------------------------------------------------------------------
//
// O lote de DATAS precisa de UM formato por turma, e ele e derivado dos
// agendamentos confirmados (`modalidade-da-turma.service.ts`). Quando a turma
// tem alunos de DOIS formatos, nada e derivado de proposito: o questionario
// tem uma janela so, e escolher a maioria trancaria a prova da minoria.
//
// So que "nada" tambem tranca — a turma inteira fica de fora do lote e a prova
// permanece com a DATA ANTIGA, para os 583 alunos EaD tanto quanto para o unico
// MODULAR. Foi o caso real de 10/09/2026: 583 x 1, e nenhuma saida na tela.
//
// Esta tabela e a saida, e ela NAO quebra a regra "nada e chutado" — ela a
// completa. O sistema continua nao escolhendo; quem escolhe e uma PESSOA, e a
// escolha fica gravada com nome e hora.
//
// ⚠️ **A linha so vale enquanto a turma for AMBIGUA**, e a checagem e feita em
// toda leitura, nunca na gravacao (ver `decidir()`):
//
//  - voltou a ter um formato so? a derivacao vence, e esta linha e ignorada.
//    O dado real e sempre mais confiavel que uma decisao de dias atras;
//  - o formato escolhido ficou sem NENHUMA reserva na turma? a linha e
//    ignorada tambem, e a turma volta a aparecer como ambigua na conferencia.
//    Aplicar a janela de um formato que ninguem ali cursa seria pior que nao
//    aplicar nada — ninguem abriria a prova, em vez de quase todos.
//
// POR QUE NAO E UMA COLUNA EM `turma_importada`: pelo mesmo motivo de 10/08/2026
// que removeu `curso` de la. Uma turma nao "e" de um formato — ela tem
// alunos de varios. O que existe aqui e uma DECISAO OPERACIONAL, valida para uma
// rodada de prova, com autor e data; escrever isso no cadastro transformaria um
// desempate pontual em um fato permanente sobre a turma. Alem disso o CSV de
// turmas e reimportado, e o upsert sobrescreveria a decisao em silencio.
//
// O RECORTE E `orgUnitId` + `rodada`, e nao inclui o periodo letivo porque o
// `orgUnitId` ja o carrega: a mesma disciplina em outro semestre e outra oferta,
// com outro id. A `rodada` entra porque a N2 e a SUB do mesmo semestre
// COMPARTILHAM o org unit — sem ela, o desempate da N2 decidiria a substitutiva,
// que tem outro publico.
model ModalidadeEscolhidaDaTurma {
  id Int @id @default(autoincrement())

  /// A oferta no Brightspace. E a mesma chave com que o mapa de formatos
  /// responde, e o que faz a decisao valer para a conferencia, para o lote
  /// manual e para o cron sem nenhum deles saber que ela existe.
  orgUnitId String
  /// Qual prova do semestre ("N2", "SUB"). Ver o recorte, acima.
  rodada    String

  modalidadeId Int

  /// Desnormalizado, como em `item_senha_quiz`: a pergunta que se faz sobre esta
  /// tabela e "quem decidiu o que?", e ela precisa de resposta legivel mesmo se
  /// a turma sair do CSV do semestre seguinte.
  codigoTurma String?

  /// Fotografia do e-mail, como em `SenhaDeProva.atualizadoPor`. NAO e FK: o
  /// admin pode ser desativado depois, e a decisao continua tendo dono.
  escolhidaPor String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modalidade Modalidade @relation(fields: [modalidadeId], references: [id])

  // Uma decisao por turma em cada rodada: duas seriam duas janelas para um
  // questionario que so tem uma. Trocar a escolha e um upsert nesta chave.
  @@unique([orgUnitId, rodada])
  @@index([modalidadeId])
  @@map("modalidade_escolhida_turma")
}

// ----------------------------------------------------------------------------
// GRUPOS NO BRIGHTSPACE — criar e inscrever pela API (14/09/2026)
// ----------------------------------------------------------------------------
//
// Substitui o import manual dos CSVs que `GET /relatorios/grupos-d2l` gerava
// (rotas removidas em 17/09/2026, com este caminho ja em uso). Os NOMES
// dos grupos continuam na grade `GrupoDaJanela` (dia x janela) — a mesma que o
// disparo do quiz usa para trocar a condicao de liberacao. Sao duas acoes
// SEPARADAS de proposito (pedido do cliente): criar as categorias e os grupos, e
// inscrever os alunos. Juntar as duas numa execucao so acumularia as requisicoes
// num botao e misturaria duas filas de pendencia diferentes.
//
// A Valence NAO tem inscricao em lote: e um POST por aluno por grupo. O que o
// lote economiza e o que ja se sabe — o `userIdD2L` gravado no agendamento (sem
// classlist) e UM `GET .../groups/` por turma, que traz os inscritos de todos os
// grupos da categoria. So sai escrita para quem falta ou mudou de horario.

enum TipoExecucaoGruposD2L {
  CRIAR_GRUPOS
  INSCREVER_ALUNOS
}

/// O que aconteceu em cada item do lote. As PENDENCIAS sao as que pedem acao —
/// ver `PENDENCIAS_GRUPOS_D2L` em src/grupos-d2l/service/resultado.ts, que e a
/// unica lista de quais sao.
enum ResultadoGruposD2L {
  // Escritas (ou, em simulacao, as que seriam feitas)
  CATEGORIA_CRIADA
  GRUPO_CRIADO
  /// Grupo VAZIO da categoria, com nome fora da lista, reaproveitado para um
  /// nome que faltava. E como os grupos genericos que a D2L cria junto com a
  /// categoria viram os grupos da prova — e como um nome corrigido na tela
  /// corrige o grupo no Brightspace sem deixar o antigo para tras.
  GRUPO_RENOMEADO
  ALUNO_INSCRITO
  /// Remanejo depois do prazo: o aluno saiu do grupo do horario antigo.
  ALUNO_REMOVIDO

  // Informativo — nao pede acao
  /// Grupo COM alunos na categoria, com nome fora da lista. Nunca e tocado.
  GRUPO_SOBRANDO

  // Pendencias
  TURMA_AMBIGUA
  CATEGORIA_AUSENTE
  /// Duas categorias com o nome do bloco na mesma turma: escolher uma no chute
  /// poria metade dos grupos numa e a condicao do quiz procurando na outra.
  CATEGORIA_DUPLICADA
  CATEGORIA_EM_PROCESSAMENTO
  GRUPO_NAO_ENCONTRADO
  HORARIO_SEM_JANELA
  SEM_GRUPO_NO_DIA
  ALUNO_DE_OUTRA_MODALIDADE
  USER_ID_INVALIDO
  ALUNO_NAO_ENCONTRADO
  /// 409 da D2L: grupo na capacidade maxima, ou categoria ainda processando.
  CONFLITO_NO_GRUPO
  FALHA_NA_API
}

model ExecucaoGruposD2L {
  id        Int                   @id @default(autoincrement())
  tipo      TipoExecucaoGruposD2L
  status    StatusExecucao        @default(EM_ANDAMENTO)
  /// true = nenhuma escrita saiu para o Brightspace. As leituras saem.
  simulacao Boolean               @default(true)

  /// O recorte, congelado no inicio — a janela vigente pode mudar no meio.
  /// Separados por virgula: a janela cobre as duas grades (modulo e semestre).
  periodoLetivoIds String   @db.VarChar(500)
  rodada           String
  /// O intervalo de DIAS DE PROVA cujos grupos o lote considera.
  de               DateTime @db.Date
  ate              DateTime @db.Date

  iniciadoPor String

  /// Resumo do que o lote quis aplicar (nomes por bloco, turmas, e no de
  /// inscricao tambem quem vai em qual grupo). Duas execucoes REAIS com a mesma
  /// assinatura e sem pendencia na anterior = nada mudou, e o botao nao gasta
  /// nenhuma chamada. `forcar` confere no Brightspace mesmo assim.
  assinatura String? @db.VarChar(64)

  totalTurmas       Int @default(0)
  turmasProcessadas Int @default(0)
  categoriasCriadas Int @default(0)
  gruposCriados     Int @default(0)
  gruposRenomeados  Int @default(0)
  inscricoes        Int @default(0)
  remocoes          Int @default(0)
  /// Quem ja estava no grupo certo. Nao vira item — seriam milhares de linhas
  /// dizendo "nada a fazer".
  jaInscritos       Int @default(0)
  pendencias        Int @default(0)

  /// So quando a execucao INTEIRA falha. Problema de uma turma vira item.
  erro String? @db.Text

  iniciadoEm   DateTime  @default(now())
  concluidoEm  DateTime?
  /// Batido a cada turma — distingue lote lento de lote morto, como no
  /// compulsorio.
  atualizadoEm DateTime  @updatedAt

  itens ItemGruposD2L[]

  @@index([status])
  @@index([tipo, status])
  @@map("execucao_grupos_d2l")
}

model ItemGruposD2L {
  id             Int                @id @default(autoincrement())
  execucaoId     Int
  orgUnitId      String
  /// Desnormalizados: o relatorio precisa ser legivel sem join, e a turma pode
  /// sair do CSV do semestre seguinte.
  codigoTurma    String?
  nomeDisciplina String?
  nomeGrupo      String?            @db.VarChar(200)
  matricula      String?
  userIdD2L      String?
  resultado      ResultadoGruposD2L
  detalhe        String?            @db.Text

  execucao ExecucaoGruposD2L @relation(fields: [execucaoId], references: [id], onDelete: Cascade)

  @@index([execucaoId, resultado])
  @@map("item_grupos_d2l")
}

// ----------------------------------------------------------------------------
// SPECIAL ACCESS POR AGENDAMENTO (15/09/2026)
// ----------------------------------------------------------------------------
// A alternativa a troca diaria de data e grupo: o questionario fica SEM data e
// restrito a quem tem special access (`TipoExecucaoQuiz.PREPARO`), e o lote
// abaixo grava, para cada aluno agendado, a janela da faixa dele e o tempo de
// prova. Os dois caminhos convivem ate o novo substituir o antigo.

/// Quem e do NIOP (Nucleo de Inclusao — pessoas com deficiencia): recebe o tempo
/// de prova do formato mais `tempoExtraNiopMinutos`.
///
/// POR MATRICULA, e fora de `AlunoImportado`, de proposito: a importacao
/// sobrescreve o vinculo a cada upload, e a marca feita na tela sumiria no
/// proximo CSV. O direito e da PESSOA — os dois cursos de um RA valem igual.
model AlunoNiop {
  matricula  String   @id
  /// Fotografia do e-mail, como `HistoricoAgendamento.autor`.
  marcadoPor String
  createdAt  DateTime @default(now())

  @@map("aluno_niop")
}

/// Linha unica (id = 1), mesmo idioma de `ConfiguracaoSenhaQuiz`.
model ConfiguracaoSpecialAccess {
  id Int @id @default(1)

  /// Somado ao tempo de prova E ao fim da janela de quem e do NIOP.
  tempoExtraNiopMinutos Int @default(60)

  /// true = o special access SUBSTITUI a troca de data e grupo: o cron para de
  /// aplicar as janelas (a senha continua) e o lote manual de datas recusa. Sem
  /// isto, o cron das 12:01 poria data de volta num questionario preparado.
  substituiJanelas Boolean @default(false)

  atualizadoPor String?
  atualizadoEm  DateTime @updatedAt

  @@map("configuracao_special_access")
}

/// UMA rodada do lote de special access. Molde: `ExecucaoGruposD2L`.
///
/// NAO faz PUT no objeto do questionario — so no recurso `specialaccess`, que e
/// separado —, e por isso pode rodar ao lado dos lotes de senha e data sem a
/// trava deles.
model ExecucaoSpecialAccess {
  id        Int            @id @default(autoincrement())
  status    StatusExecucao @default(EM_ANDAMENTO)
  /// true = nenhuma escrita saiu para o Brightspace. As leituras saem.
  simulacao Boolean        @default(true)

  /// O recorte, congelado no inicio.
  periodoLetivoIds String  @db.VarChar(500)
  rodada           String
  /// As turmas escolhidas, separadas por virgula. Nulo = todas as que tem
  /// reserva na rodada. Serve para fatiar a carga contra o Brightspace — o lote
  /// e uma chamada por aluno em cada questionario.
  orgUnitIds       String? @db.VarChar(1000)

  nomeQuizAlvo          String
  matchQuizAlvo         TipoMatchQuiz
  tempoExtraNiopMinutos Int

  iniciadoPor String

  totalTurmas       Int @default(0)
  turmasProcessadas Int @default(0)
  gravados          Int @default(0)
  atualizados       Int @default(0)
  removidos         Int @default(0)
  /// Quem ja tinha o acesso certo. Nao vira item — seriam milhares de linhas.
  jaCorretos        Int @default(0)
  pendencias        Int @default(0)

  erro String? @db.Text

  iniciadoEm   DateTime  @default(now())
  concluidoEm  DateTime?
  atualizadoEm DateTime  @updatedAt

  itens ItemSpecialAccess[]

  @@index([status])
  @@map("execucao_special_access")
}

/// O que aconteceu com cada aluno (ou turma) do lote. As PENDENCIAS sao as de
/// `PENDENCIAS_SPECIAL_ACCESS` em src/special-access/service/resultado.ts.
enum ResultadoSpecialAccess {
  ACESSO_GRAVADO
  /// O aluno ja tinha special access, com outro horario ou outro tempo — o
  /// remanejo cai aqui.
  ACESSO_ATUALIZADO
  /// Prova cancelada: o acesso que o portal tinha dado saiu.
  ACESSO_REMOVIDO
  /// Special access de alguem sem reserva nesta turma. Nunca e tocado — pode ser
  /// um acesso dado a mao no AVA.
  ACESSO_DE_OUTRO_USUARIO

  QUIZ_NAO_ENCONTRADO
  /// O questionario NAO esta restrito a quem tem special access: a prova esta
  /// aberta para a turma toda. Rode o preparo.
  QUESTIONARIO_NAO_RESTRITO
  /// O mesmo usuario com duas reservas confirmadas, em horarios diferentes, na
  /// mesma turma. Nada e escolhido.
  RESERVA_DUPLICADA
  USER_ID_INVALIDO
  /// 404 da D2L: em geral o aluno nao esta matriculado nesta turma.
  ALUNO_NAO_ENCONTRADO
  FALHA_NA_API
}

model ItemSpecialAccess {
  id         Int @id @default(autoincrement())
  execucaoId Int

  orgUnitId      String
  /// Desnormalizados: o relatorio precisa ser legivel sem join.
  codigoTurma    String?
  nomeDisciplina String?
  quizId         String?
  nomeQuiz       String?
  matricula      String?
  userIdD2L      String?

  resultado ResultadoSpecialAccess

  /// A janela e o tempo gravados (ou que seriam, na simulacao), em UTC —
  /// fotografia, para "por que a prova dele abriu as 11h?" ter resposta depois.
  startDate DateTime?
  endDate   DateTime?
  minutos   Int?
  niop      Boolean   @default(false)

  detalhe String? @db.Text

  execucao ExecucaoSpecialAccess @relation(fields: [execucaoId], references: [id], onDelete: Cascade)

  @@index([execucaoId, resultado])
  @@map("item_special_access")
}
